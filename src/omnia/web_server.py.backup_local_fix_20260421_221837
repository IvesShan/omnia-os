def simplify_model_name(filename: str) -> str:
    """Simplify model filename to friendly name.
    
    Examples:
    - gemma-4-E4B-it-OBLITERATED-Q8_0.gguf → Gemma 4 4B (Q8_0)
    - Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf → Qwen 2.5 Coder 7B (Q4_K_M)
    """
    import re
    name = filename.replace('.gguf', '').replace('.GGUF', '')
    
    model_names = {
        'gemma': 'Gemma', 'qwen': 'Qwen', 'llama': 'Llama',
        'mistral': 'Mistral', 'phi': 'Phi', 'deepseek': 'DeepSeek',
        'yi': 'Yi', 'chatglm': 'ChatGLM', 'baichuan': 'Baichuan',
    }
    
    model_family = 'Unknown'
    for key, display in model_names.items():
        if key.lower() in name.lower():
            model_family = display
            break
    
    size_match = re.search(r'(\d+(?:\.\d+)?)[Bb]', name, re.IGNORECASE)
    size = size_match.group(0).upper() if size_match else ''
    size = size.replace('E', '')
    
    version_match = re.search(rf'{model_family.lower()}[\s\-_]?(\d+(?:\.\d+)?)', name, re.IGNORECASE)
    version = version_match.group(1) if version_match else ''
    
    quant_match = re.search(r'Q\d+(?:_\w+)?', name, re.IGNORECASE)
    quant = quant_match.group(0).upper() if quant_match else ''
    
    variants = []
    for v in ['coder', 'instruct', 'chat', 'math', 'vision']:
        if v in name.lower():
            variants.append(v.capitalize())
    
    parts = [model_family]
    if version: parts.append(version)
    if variants: parts.append(' '.join(variants))
    if size: parts.append(size)
    
    friendly = ' '.join(parts)
    if quant: friendly += f' ({quant})'
    
    return friendly if friendly != model_family else filename



