    @app.route("/api/providers", methods=["GET"])
    def get_providers_route():
        """Return available API providers and current selection."""
        global _current_provider
        
        providers = []
        env_vars = {
            "local": ("LOCAL_LLM_ENABLED", "本地 GPU", "Qwen2.5-Coder-7B"),
            "qianfan": ("QIANFAN_API_KEY", "百度千帆", "baiduqianfancodingplan/qianfan-code-latest"),
            "kimi": ("MOONSHOT_API_KEY", "Moonshot", "K2.6-code-preview"),
            "openai": ("OPENAI_API_KEY", "OpenAI", "gpt-4o"),
            "anthropic": ("ANTHROPIC_API_KEY", "Anthropic", "claude-3-5-sonnet-20241022"),
        }
        
        # Check which providers are configured
        for pid, (env_key, name, default_model) in env_vars.items():
            configured = bool(os.environ.get(env_key))
            # Also check .env file (skip comments and empty lines)
            if not configured:
                env_file = PROJECT_ROOT / ".env"
                if env_file.exists():
                    for line in env_file.read_text(encoding="utf-8").splitlines():
                        line = line.strip()
                        if not line or line.startswith("#"):
                            continue
                        if line.startswith(f"{env_key}="):
                            configured = True
                            break
            
            model = os.environ.get(f"{pid.upper()}_MODEL", default_model)
            
            # Special handling for local provider
            if pid == "local":
                # Read LOCAL_LLM_MODEL from .env file
                env_file = PROJECT_ROOT / ".env"
                if env_file.exists():
                    for line in env_file.read_text(encoding="utf-8").splitlines():
                        line = line.strip()
                        if line.startswith("LOCAL_LLM_MODEL="):
                            model = line.split("=", 1)[1].strip()
                            break
                # Also check environment variable
                model = simplify_model_name(os.environ.get("LOCAL_LLM_MODEL", model))
            
            # Special check for local LLM - verify service is running
            if pid == "local":
                try:
                    import requests
                    resp = requests.get("http://localhost:8080/health", timeout=1)
                    configured = resp.status_code == 200
                except:
                    configured = False
            
            providers.append({
                "id": pid,
                "name": name,
                "configured": configured,
                "model": model,
            })
        
        # Determine active provider
        # Priority: _current_provider > actual API key in .env > first CONFIGURED provider
        # Important: We want to show the ACTUAL provider being used for chat!
        active = None
        
        # 1. Check _current_provider first (user manually selected)
        if _current_provider:
            for p in providers:
                if p["id"] == _current_provider and p["configured"]:
                    active = _current_provider
                    break
        
        # 2. Detect actual provider from .env (same logic as _load_api_key)
        if not active:
            env_file = PROJECT_ROOT / ".env"
            env_content = ""
            if env_file.exists():
                env_content = env_file.read_text(encoding="utf-8")
            
            # Check API keys in priority order (same as chat.py _load_api_key)
            api_key_priority = [
                ("qianfan", ["QIANFAN_API_KEY", "QIANFAN_ACCESS_KEY"]),
                ("kimi", ["MOONSHOT_API_KEY", "KIMI_API_KEY"]),
                ("openai", ["OPENAI_API_KEY"]),
                ("anthropic", ["ANTHROPIC_API_KEY"]),
            ]
            
            for provider_id, key_names in api_key_priority:
                for key_name in key_names:
                    if os.environ.get(key_name) or f"{key_name}=" in env_content:
                        # Verify this provider is in the list
                        for p in providers:
                            if p["id"] == provider_id and p["configured"]:
                                active = provider_id
                                break
                    if active:
                        break
                if active:
                    break
        
        # 3. Fallback: first configured provider
        if not active:
            for p in providers:
                if p["configured"]:
                    active = p["id"]
                    break
        
        return jsonify({
            "providers": providers,
            "active": active,
        })

