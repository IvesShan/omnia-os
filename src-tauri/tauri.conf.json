{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnia",
  "version": "1.1.1",
  "identifier": "com.omnia.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5001",
    "beforeBuildCommand": "",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Omnia AIOS",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "settings",
        "title": "Omnia 设置",
        "url": "settings.html",
        "width": 800,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png"
    ],
    "resources": [
      "../web/**/*",
      "../seeds/**/*",
      "../config/**/*",
      "../backend/standalone_main.py"
    ],
    "externalBin": [
      "binaries/omnia-backend"
    ]
  }
}
