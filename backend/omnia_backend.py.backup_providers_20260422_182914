@app.route('/api/model/switch', methods=['POST'])
def switch_model():
    """
    切换模型模式
    
    参数：
    - mode: "local_only" | "cloud_only" | "auto"
    
    返回：
    - success: 是否成功
    - mode: 当前模式
    - message: 提示信息
    """
    try:
        import asyncio
        data = request.get_json()
        mode = data.get('mode', 'auto')
        
        # 验证模式
        valid_modes = ['local_only', 'cloud_only', 'auto']
        if mode not in valid_modes:
            return jsonify({
                'success': False,
                'error': f'Invalid mode: {mode}. Valid modes: {valid_modes}'
            }), 400
        
        # 如果切换到本地模式，检查本地模型是否可用
        if mode == 'local_only':
            if not asyncio.run(model_router.is_local_available()):
                return jsonify({
                    'success': False,
                    'error': '本地模型不可用，请检查 llama.cpp server 是否运行'
                }), 400
        
        # 切换模式
        model_router.set_mode(mode)
        
        # 保存到配置
        config_manager.config['model'] = config_manager.config.get('model', {})
        config_manager.config['model']['mode'] = mode
        config_manager.save_config(config_manager.config)
        
        mode_display_map = {
            'local_only': '🖥️ 本地 GPU',
            'cloud_only': '☁️ 云端模型',
            'auto': '🤖 智能选择'
        }
        
        logger.info(f"Model switched to {mode}")
        
        return jsonify({
            'success': True,
            'mode': mode,
            'mode_display': mode_display_map.get(mode, mode),
            'message': f'已切换到 {mode_display_map.get(mode, mode)}'
        })
    except Exception as e:
        logger.error(f"Failed to switch model: {e}")
        return jsonify({'success': False, 'error': str(e)}), 500


@app.route('/api/model/health', methods=['GET'])
def check_model_health():
    """
    检查本地模型健康状态
    
    返回：
    - local_available: 本地模型是否可用
    - response_time: 响应时间（毫秒）
    - gpu_memory: GPU 内存使用情况（如果可用）
    """
    try:
        import asyncio
        import time
        start_time = time.time()
        
        # 检查本地模型是否可用
        local_available = asyncio.run(model_router.is_local_available())
        
        response_time = int((time.time() - start_time) * 1000)
        
        # 尝试获取 GPU 信息
        gpu_info = {}
        try:
            import subprocess
            result = subprocess.run(
                ['nvidia-smi', '--query-gpu=memory.used,memory.total', '--format=csv,noheader,nounits'],
                capture_output=True,
                text=True,
                timeout=2
            )
            if result.returncode == 0:
                used, total = result.stdout.strip().split(',')
                gpu_info = {
                    'memory_used_mb': int(used.strip()),
                    'memory_total_mb': int(total.strip()),
                    'memory_percent': int(int(used.strip()) / int(total.strip()) * 100)
                }
        except:
            pass
        
        return jsonify({
            'local_available': local_available,
            'response_time_ms': response_time,
            'gpu': gpu_info
        })
    except Exception as e:
        logger.error(f"Failed to check model health: {e}")
        return jsonify({'error': str(e)}), 500

