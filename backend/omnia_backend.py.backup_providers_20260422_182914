class ConfigManager:
    """配置管理器"""
    
    def __init__(self):
        self.config_file = CONFIG_DIR / 'settings.json'
        self.api_keys_file = CONFIG_DIR / 'api_keys.json'
        self.config = self.load_config()
        self.api_keys = self.load_api_keys()
    
    def load_config(self) -> Dict:
        """加载配置"""
        if self.config_file.exists():
            try:
                with open(self.config_file, 'r') as f:
                    return json.load(f)
            except Exception as e:
                logger.error(f"Failed to load config: {e}")
        
        # 默认配置
        return {
            'backend': {
                'port': 5001,
                'auto_start': True,
                'log_level': 'info'
            },
            'api': {
                'default_model': 'ernie-4.0-8k',
                'provider': 'baidu'
            },
            'memory': {
                'max_entries': 10000
            }
        }
    
    def load_api_keys(self) -> Dict:
        """加载 API 密钥"""
        if self.api_keys_file.exists():
            try:
                with open(self.api_keys_file, 'r') as f:
                    return json.load(f)
            except Exception as e:
                logger.error(f"Failed to load API keys: {e}")
        
        return {
            'baidu_api_key': '',
            'baidu_secret_key': '',
            'kimi_api_key': ''
        }
    
    def save_config(self, config: Dict):
        """保存配置"""
        self.config = config
        with open(self.config_file, 'w') as f:
            json.dump(config, f, indent=2)
        logger.info("Config saved")
    
    def save_api_keys(self, api_keys: Dict):
        """保存 API 密钥"""
        self.api_keys = api_keys
        with open(self.api_keys_file, 'w') as f:
            json.dump(api_keys, f, indent=2)
        logger.info("API keys saved")
    
    def get(self, key: str, default=None):
        """获取配置项"""
        keys = key.split('.')
        value = self.config
        for k in keys:
            if isinstance(value, dict):
                value = value.get(k)
            else:
                return default
        return value if value is not None else default

config_manager = ConfigManager()

# ============ Agent 管理 ============

class AgentManager:
    """Agent 管理器"""
    
    def __init__(self):
        self.agents_dir = DATA_DIR / 'agents'
        self.agents_dir.mkdir(parents=True, exist_ok=True)
        self.agents = self.load_agents()
    
    def load_agents(self) -> Dict[str, Dict]:
        """加载所有 Agent"""
        agents = {}
        for agent_file in self.agents_dir.glob('*.json'):
            try:
                with open(agent_file, 'r') as f:
                    agent = json.load(f)
                    agents[agent['id']] = agent
            except Exception as e:
                logger.error(f"Failed to load agent {agent_file}: {e}")
        
        # 默认 Agent
        if not agents:
            default_agent = {
                'id': 'infinite',
                'name': 'Infinite',
                'role': 'AI Assistant',
                'system_prompt': 'You are Infinite (无限), a helpful AI assistant.',
                'created_at': datetime.now().isoformat(),
                'model': config_manager.get('api.default_model', 'ernie-4.0-8k')
            }
            agents['infinite'] = default_agent
            # 直接保存文件，不调用 save_agent（因为 self.agents 还未初始化）
            agent_file = self.agents_dir / f"{default_agent['id']}.json"
            with open(agent_file, 'w') as f:
                json.dump(default_agent, f, indent=2)
            logger.info(f"Created default agent: {default_agent['id']}")
        
        return agents
    
    def save_agent(self, agent: Dict):
        """保存 Agent"""
        agent_file = self.agents_dir / f"{agent['id']}.json"
        with open(agent_file, 'w') as f:
            json.dump(agent, f, indent=2)
        self.agents[agent['id']] = agent
        logger.info(f"Agent saved: {agent['id']}")
    
    def delete_agent(self, agent_id: str):
        """删除 Agent"""
        agent_file = self.agents_dir / f"{agent_id}.json"
        if agent_file.exists():
            agent_file.unlink()
        if agent_id in self.agents:
            del self.agents[agent_id]
        logger.info(f"Agent deleted: {agent_id}")
    
    def list_agents(self) -> List[Dict]:
        """列出所有 Agent"""
        return list(self.agents.values())

agent_manager = AgentManager()

