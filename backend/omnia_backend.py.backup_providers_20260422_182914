@app.route('/api/status', methods=['GET'])
def get_status():
    """获取系统状态 - 前端 HUD 使用"""
    try:
        # 读取技能数量
        skills_file = Path(__file__).parent.parent / 'skills' / '.omnia' / 'active_skills.json'
        skills_data = {'active': 0, 'inactive': 0, 'total': 0}
        
        if skills_file.exists():
            with open(skills_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
                active = len(data.get('active_skills', []))
                inactive = len(data.get('inactive_skills', []))
                skills_data = {
                    'active': active,
                    'inactive': inactive,
                    'total': active + inactive,
                    'count': active  # 兼容旧版
                }
        
        # 读取记忆数量
        memory_file = Path(__file__).parent.parent / 'memory' / 'MEMORY.md'
        memory_stats = {'facts': 0, 'relations': 0, 'habits': 0, 'timeline': 0, 'conversation_logs': 0}
        
        if memory_file.exists():
