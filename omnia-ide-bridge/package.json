{
  "name": "omnia-ide-bridge",
  "displayName": "Omnia AI Assistant",
  "description": "AI-powered coding assistant: chat (@omnia), inline edit with diff, CodeLens, code completion",
  "version": "0.4.0",
  "publisher": "origin",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "omnia.explainCode",
        "title": "Omnia: Explain Code",
        "icon": "$(info)"
      },
      {
        "command": "omnia.fixCode",
        "title": "Omnia: Fix Code",
        "icon": "$(wrench)"
      },
      {
        "command": "omnia.inlineEdit",
        "title": "Omnia: Edit with AI (Diff Preview)",
        "icon": "$(edit)"
      },
      {
        "command": "omnia.quickEdit",
        "title": "Omnia: Quick Edit",
        "icon": "$(zap)"
      },
      {
        "command": "omnia.commitChanges",
        "title": "Omnia: Generate Commit Message",
        "icon": "$(git-commit)"
      },
      {
        "command": "omnia.sendToChat",
        "title": "Omnia: Send to Chat",
        "icon": "$(send)"
      },
      {
        "command": "omnia.generateTests",
        "title": "Omnia: Generate Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "omnia.clearHistory",
        "title": "Omnia: Clear Chat History",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "omnia.explainCode",
          "when": "editorHasSelection",
          "group": "omnia@1"
        },
        {
          "command": "omnia.fixCode",
          "when": "editorHasSelection",
          "group": "omnia@2"
        },
        {
          "command": "omnia.inlineEdit",
          "when": "editorHasSelection",
          "group": "omnia@3"
        },
        {
          "command": "omnia.quickEdit",
          "group": "omnia@4"
        },
        {
          "command": "omnia.sendToChat",
          "when": "editorHasSelection",
          "group": "omnia@5"
        }
      ],
      "commandPalette": [
        { "command": "omnia.explainCode", "when": "editorHasSelection" },
        { "command": "omnia.fixCode", "when": "editorHasSelection" },
        { "command": "omnia.inlineEdit", "when": "editorHasSelection" },
        { "command": "omnia.quickEdit" },
        { "command": "omnia.commitChanges" },
        { "command": "omnia.sendToChat", "when": "editorHasSelection" },
        { "command": "omnia.generateTests" },
        { "command": "omnia.clearHistory" }
      ]
    },
    "keybindings": [
      {
        "command": "omnia.inlineEdit",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorHasSelection"
      },
      {
        "command": "omnia.quickEdit",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "omnia.sendToChat",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Omnia AI Assistant",
      "properties": {
        "omnia.ideBridge.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable sending context to Omnia"
        },
        "omnia.ideBridge.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Omnia backend endpoint"
        },
        "omnia.ideBridge.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay for selection changes"
        },
        "omnia.ai.autoInjectContext": {
          "type": "boolean",
          "default": true,
          "description": "Auto-inject current file context into chat"
        },
        "omnia.ai.maxContextLength": {
          "type": "number",
          "default": 4000,
          "description": "Maximum context length to send (characters)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0"
  }
}
