[Unit]
Description=Omnia OS - FastAPI Main Application (Port 8765)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=shan
Group=shan
WorkingDirectory=/home/shan/omnia-os
Environment="PATH=/home/shan/omnia-os/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/shan/omnia-os"
ExecStart=/home/shan/omnia-os/venv/bin/python3 -m uvicorn src.omnia.main:app --host 0.0.0.0 --port 8765 --log-level info
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# 日志
StandardOutput=append:/home/shan/omnia-os/logs/omnia-main.log
StandardError=append:/home/shan/omnia-os/logs/omnia-main.log

# 安全限制
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/shan/omnia-os /home/shan/.omnia

[Install]
WantedBy=multi-user.target
