/* === 神经图谱动画效果 === */

/* 动态场景容器 */
.neural-scene {
  position: relative;
  width: 100%;
  height: 280px;
  overflow: hidden;
}

/* 呼吸环 - 背景动态效果 */
.neural-ring {
  position: absolute;
  border: 1px solid;
  border-radius: 50%;
  opacity: 0.15;
  pointer-events: none;
  animation: neural-pulse 4s ease-in-out infinite;
}

.neural-ring.r1 {
  width: 200px;
  height: 200px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-color: #22d3ee;
  animation-delay: 0s;
}

.neural-ring.r2 {
  width: 260px;
  height: 260px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-color: #a855f7;
  animation-delay: 1s;
}

.neural-ring.r3 {
  width: 320px;
  height: 320px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-color: #22d3ee;
  animation-delay: 2s;
}

@keyframes neural-pulse {
  0%, 100% {
    opacity: 0.1;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.25;
    transform: translate(-50%, -50%) scale(1.05);
  }
}

/* 思维火花粒子 */
.neural-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.neural-particles span {
  position: absolute;
  width: 3px;
  height: 3px;
  background: #22d3ee;
  border-radius: 50%;
  box-shadow: 0 0 6px #22d3ee;
  animation: particle-float 8s ease-in-out infinite;
}

.neural-particles span:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
.neural-particles span:nth-child(2) { left: 25%; top: 60%; animation-delay: 1s; background: #a855f7; box-shadow: 0 0 6px #a855f7; }
.neural-particles span:nth-child(3) { left: 40%; top: 30%; animation-delay: 2s; }
.neural-particles span:nth-child(4) { left: 55%; top: 70%; animation-delay: 3s; background: #30d158; box-shadow: 0 0 6px #30d158; }
.neural-particles span:nth-child(5) { left: 70%; top: 40%; animation-delay: 4s; }
.neural-particles span:nth-child(6) { left: 85%; top: 80%; animation-delay: 5s; background: #ff9f0a; box-shadow: 0 0 6px #ff9f0a; }
.neural-particles span:nth-child(7) { left: 15%; top: 85%; animation-delay: 6s; }
.neural-particles span:nth-child(8) { left: 60%; top: 15%; animation-delay: 7s; background: #a855f7; box-shadow: 0 0 6px #a855f7; }

@keyframes particle-float {
  0%, 100% {
    opacity: 0.3;
    transform: translateY(0) scale(1);
  }
  25% {
    opacity: 0.8;
    transform: translateY(-10px) scale(1.2);
  }
  50% {
    opacity: 0.5;
    transform: translateY(-5px) scale(0.9);
  }
  75% {
    opacity: 0.9;
    transform: translateY(-15px) scale(1.1);
  }
}

