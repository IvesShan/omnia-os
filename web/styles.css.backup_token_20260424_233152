.holo-particles span:nth-child(2) { transform: rotate(45deg) translate(68px); animation: particleOrbit 7.5s linear infinite reverse; }
.holo-particles span:nth-child(3) { transform: rotate(90deg) translate(68px); animation: particleOrbit 9.0s linear infinite; }
.holo-particles span:nth-child(4) { transform: rotate(135deg) translate(68px); animation: particleOrbit 6.75s linear infinite reverse; }
.holo-particles span:nth-child(5) { transform: rotate(180deg) translate(68px); animation: particleOrbit 8.25s linear infinite; }
.holo-particles span:nth-child(6) { transform: rotate(225deg) translate(68px); animation: particleOrbit 9.75s linear infinite reverse; }
.holo-particles span:nth-child(7) { transform: rotate(270deg) translate(68px); animation: particleOrbit 6.300000000000001s linear infinite; }
.holo-particles span:nth-child(8) { transform: rotate(315deg) translate(68px); animation: particleOrbit 7.800000000000001s linear infinite reverse; }

@keyframes particleOrbit {
