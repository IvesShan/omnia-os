/* === 神经图谱 - 极简静态版本 === */

.graph-simple-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.graph-edges-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.graph-node-simple {
  position: absolute;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  border: 2px solid;
}

.graph-node-simple:hover {
  transform: scale(1.3);
  z-index: 100;
}

.graph-node-simple.highlighted {
  transform: scale(1.5);
  box-shadow: 0 0 20px rgba(34, 211, 238, 0.8);
}

/* 节点类型颜色 - Omnia HUD 青色系 */
.graph-node-simple.project {
  background: rgba(34, 211, 238, 0.2);
  border-color: #22d3ee;
  color: #22d3ee;
}

.graph-node-simple.person {
  background: rgba(6, 182, 212, 0.2);
  border-color: #06b6d4;
  color: #06b6d4;
}

.graph-node-simple.file {
  background: rgba(14, 116, 144, 0.2);
  border-color: #0e7490;
  color: #0e7490;
}

.graph-node-simple.concept {
  background: rgba(21, 94, 117, 0.2);
  border-color: #155e75;
  color: #155e75;
}

.graph-node-simple.date {
  background: rgba(22, 78, 99, 0.2);
  border-color: #164e63;
  color: #164e63;
}

.graph-node-simple.location {
  background: rgba(8, 145, 178, 0.2);
  border-color: #0891b2;
  color: #0891b2;
}

.graph-node-simple.unknown {
  background: rgba(30, 58, 95, 0.2);
  border-color: #1e3a5f;
  color: #1e3a5f;
}

.node-label {
  font-size: 9px;
  font-weight: 600;
  text-shadow: 0 0 4px rgba(0, 0, 0, 0.8);
}

.graph-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #22d3ee;
}

.graph-error {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #ff453a;
}

/* === 神经图谱 - Omnia 存在可视化 === */

/* 神经图谱面板 */
.neural-panel {
  position: relative;
}

.neural-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 动态场景容器 */
.neural-scene {
  width: 100%;
  height: 180px;
  position: relative;
  perspective: 900px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 6px;
  background: radial-gradient(ellipse at center, rgba(34,211,238,0.05) 0%, transparent 70%);
}

/* 呼吸环 - 继承全息投影效果 */
.neural-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(34,211,238,0.25);
  pointer-events: none;
  opacity: 0.6;
}

.neural-ring.r1 {
  width: 120px;
  height: 120px;
  border-color: rgba(34,211,238,0.4);
  animation: neuralSpinX 10s linear infinite;
  box-shadow: 0 0 16px rgba(34,211,238,0.15);
}

.neural-ring.r2 {
  width: 145px;
  height: 145px;
  border-color: rgba(168,85,247,0.35);
  animation: neuralSpinY 14s linear infinite;
  box-shadow: 0 0 16px rgba(168,85,247,0.12);
}

.neural-ring.r3 {
  width: 170px;
  height: 170px;
  border-color: rgba(34,211,238,0.2);
  animation: neuralSpinZ 18s linear infinite;
}

@keyframes neuralSpinX {
  0% { transform: rotateX(60deg) rotateY(0deg) rotateZ(0deg); }
  100% { transform: rotateX(60deg) rotateY(360deg) rotateZ(0deg); }
}

@keyframes neuralSpinY {
  0% { transform: rotateX(0deg) rotateY(60deg) rotateZ(0deg); }
  100% { transform: rotateX(0deg) rotateY(60deg) rotateZ(360deg); }
}

@keyframes neuralSpinZ {
  0% { transform: rotateX(70deg) rotateY(20deg) rotateZ(0deg); }
  100% { transform: rotateX(70deg) rotateY(20deg) rotateZ(-360deg); }
}

/* 图谱画布 - 叠加在动态背景上 */
.neural-scene .graph-canvas {
  position: absolute;
  inset: 0;
  z-index: 10;
  background: transparent !important;
}

.graph-placeholder {
  color: rgba(34,211,238,0.5);
  font-size: 12px;
  text-align: center;
  padding: 60px 20px;
  cursor: pointer;
  transition: all 0.3s;
}

.graph-placeholder:hover {
  color: rgba(34,211,238,0.8);
  text-shadow: 0 0 10px rgba(34,211,238,0.5);
}

/* 思维火花粒子 */
.neural-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 5;
}

.neural-particles span {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--cyan, #22d3ee);
  opacity: 0.6;
  top: 50%;
  left: 50%;
}

.neural-particles span:nth-child(1) { transform: rotate(0deg) translate(75px); animation: sparkOrbit 6.0s linear infinite; }
.neural-particles span:nth-child(2) { transform: rotate(45deg) translate(75px); animation: sparkOrbit 7.5s linear infinite reverse; }
.neural-particles span:nth-child(3) { transform: rotate(90deg) translate(75px); animation: sparkOrbit 9.0s linear infinite; }
.neural-particles span:nth-child(4) { transform: rotate(135deg) translate(75px); animation: sparkOrbit 6.75s linear infinite reverse; }
.neural-particles span:nth-child(5) { transform: rotate(180deg) translate(75px); animation: sparkOrbit 8.25s linear infinite; }
.neural-particles span:nth-child(6) { transform: rotate(225deg) translate(75px); animation: sparkOrbit 9.75s linear infinite reverse; }
.neural-particles span:nth-child(7) { transform: rotate(270deg) translate(75px); animation: sparkOrbit 6.3s linear infinite; }
.neural-particles span:nth-child(8) { transform: rotate(315deg) translate(75px); animation: sparkOrbit 7.8s linear infinite reverse; }

@keyframes sparkOrbit {
  0% { opacity: 0.3; }
  50% { opacity: 1; box-shadow: 0 0 8px var(--cyan, #22d3ee); }
  100% { opacity: 0.3; }
}

/* 统计数据 */
.graph-stats {
  display: flex;
  gap: 16px;
  justify-content: center;
  padding: 8px 12px;
  background: rgba(34,211,238,0.05);
  border-radius: 4px;
  border: 1px solid rgba(34,211,238,0.15);
}

.gs-item {
  font-size: 11px;
  color: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  gap: 6px;
}

.gs-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 16px;
  font-weight: 600;
  color: #22d3ee;
  text-shadow: 0 0 10px rgba(34,211,238,0.5);
}

/* 搜索控件 */
.graph-controls {
  display: flex;
  gap: 8px;
}

#graph-search-input {
  flex: 1;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(34,211,238,0.2);
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 12px;
  color: #fff;
  font-family: inherit;
}

#graph-search-input:focus {
  outline: none;
  border-color: rgba(34,211,238,0.5);
  box-shadow: 0 0 10px rgba(34,211,238,0.2);
}

#graph-search-btn {
  background: linear-gradient(135deg, rgba(34,211,238,0.2), rgba(168,85,247,0.2));
  border: 1px solid rgba(34,211,238,0.3);
  border-radius: 4px;
  padding: 6px 14px;
  font-size: 12px;
  color: #22d3ee;
  cursor: pointer;
  transition: all 0.2s;
}

#graph-search-btn:hover {
  background: linear-gradient(135deg, rgba(34,211,238,0.3), rgba(168,85,247,0.3));
  box-shadow: 0 0 15px rgba(34,211,238,0.3);
