  }
}

function appendToolStep(tool, args, resultPreview, status) {
  const argPreview = JSON.stringify(args).slice(0, 80);
  const statusLabel = status === 'done' ? '完成' : status === 'error' ? '失败' : '执行中';
  
  // SVG icons instead of emoji
  const icons = {
    done: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>`,
    error: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>`,
    running: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2" class="spin"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`
  };
  const statusIcon = icons[status] || icons.running;
  
  const html = `
    <div class="msg omnia tool-msg">
      <div class="tool-bubble">
        <div class="tool-icon">${statusIcon}</div>
        <div class="tool-info">
          <div class="tool-name">${escapeHtml(tool)}</div>
          <div class="tool-args">${escapeHtml(argPreview)}${argPreview.length >= 80 ? '...' : ''}</div>
          <div class="tool-result">${escapeHtml(resultPreview)}${resultPreview.length >= 120 ? '...' : ''}</div>
        </div>
      </div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  scrollToBottom();
}

function appendSwarmBadge(agent) {
  const roleLabels = {
    frontend: '前端代理',
    backend: '后端代理',
    devops: 'DevOps代理',
    research: '情报代理',
    general: '执行代理',
  };
  const statusColors = {
    done: 'var(--success)',
    error: 'var(--danger)',
    blocked: 'var(--warn)',
    running: 'var(--cyan)',
  };
  const statusIcons = {
    done: '✓',
    error: '✗',
    blocked: '◐',
    running: '⟳',
  };
  const label = roleLabels[agent.role] || agent.role;
  const color = statusColors[agent.status] || 'var(--text-secondary)';
  const icon = statusIcons[agent.status] || '•';
  const html = `
    <div class="msg omnia tool-msg">
      <div class="tool-bubble" style="border-color: ${color}33;">
        <div class="tool-icon" style="color:${color};">${icon}</div>
        <div class="tool-info">
          <div class="tool-name" style="color:${color};">${escapeHtml(label)}</div>
          <div class="tool-args">${escapeHtml(agent.goal)}</div>
          <div class="tool-result">${escapeHtml(agent.reply || '').slice(0, 200)}${(agent.reply || '').length > 200 ? '...' : ''}</div>
        </div>
      </div>
      <div class="meta">Swarm · ${escapeHtml(agent.status)}</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  pushChat(html, 'tool');
  scrollToBottom();
}

let activeTypewriter = null;

function appendOmnia(text) {
  const safeText = escapeHtml(text).replace(/"/g, '&quot;');
  const duration = Math.max(0.6, Math.min(5, text.length / 18));
  const html = `
    <div class="msg omnia">
      <div class="omnia-bubble-wrap">
        <div class="bubble typing" style="animation-duration:${duration}s">${formatReply(text)}</div>
        <button class="copy-btn" data-copy-text="${safeText}" title="复制文本">复制</button>
      </div>
      <div class="meta">Omnia · 刚刚</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  addToHistory('assistant', text, html);
  scrollToBottom();

  const bubble = messagesEl.lastElementChild.querySelector('.bubble');
  activeTypewriter = bubble;
  let rafId;
  const scrollLoop = () => {
    if (activeTypewriter === bubble) {
      scrollToBottom();
      rafId = requestAnimationFrame(scrollLoop);
    }
  };
  rafId = requestAnimationFrame(scrollLoop);

  setTimeout(() => {
    bubble.classList.remove('typing');
    if (activeTypewriter === bubble) activeTypewriter = null;
    cancelAnimationFrame(rafId);
    scrollToBottom();
  }, duration * 1000);
}

// --- 发送消息 ---
async function sendMessage() {
  const text = composer.value.trim();
  const hasImage = selectedImage !== null;
  
  // 如果既没有文字也没有图片，不发送
  if (!text && !hasImage) return;

  // 用户发送消息，重置滚动状态
  userScrolledUp = false;
  
  // 如果有图片，显示图片消息
  if (hasImage) {
    appendUserWithImage(text, selectedImage);
  } else {
    appendUser(text);
  }
  
  // 清空输入
  composer.value = '';
  selectedImage = null;
  imagePreview.style.display = 'none';
  imageInput.value = '';
  autoResize();
  composer.disabled = true;
  sendBtn.disabled = true;
  attachBtn.disabled = true;
  
  // 构建历史消息
  const history = chatHistory.slice(-10).map(m => ({
    role: m.role,
    content: m.content
  }));

  // 使用 SSE 流式端点
  try {
    const response = await fetch(`${API_BASE}/api/chat/stream`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, history: history }),
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let currentContent = '';
    let omniaMsg = null;

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      const chunk = decoder.decode(value, { stream: true });
      const lines = chunk.split('\n');

      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;

        const dataStr = line.slice(6);
        if (!dataStr) continue;

        try {
          const data = JSON.parse(dataStr);

          if (data.type === 'status') {
            // 显示状态时自动滚动到底部
            showTyping(data.message || '正在思考...');
            scrollToBottom(true);  // 强制滚动
          }

          else if (data.type === 'token') {
            // 流式 token - 第一次收到时移除 thinking
            if (!omniaMsg) {
              removeTyping();
              omniaMsg = createOmniaMessage();
            }
            currentContent += data.content;
            updateOmniaMessage(omniaMsg, currentContent);
          }

          else if (data.type === 'tool_call') {
            // 工具调用开始
            appendToolCard(data.name, data.args, 'running');
          }

          else if (data.type === 'tool_result') {
            // 工具执行成功
            updateToolCard(data.name, data.result, 'done');
          }

          else if (data.type === 'tool_error') {
            // 工具执行失败
            updateToolCard(data.name, data.error, 'error');
          }

          else if (data.type === 'done') {
            // 完成
            removeTyping();
            
            // 最终回复应该放在最后（工具卡片之后）
            // 优先使用 data.full_content（模型最终输出），而不是 currentContent（流式累积）
            const finalContent = data.full_content || currentContent;
            
            if (finalContent && finalContent !== '[未生成响应]') {
              if (omniaMsg) {
                // 把 omniaMsg 移动到最后（确保在所有工具卡片之后）
                messagesEl.appendChild(omniaMsg);
                updateOmniaMessage(omniaMsg, finalContent, true);
                // 保存到聊天历史
                const html = omniaMsg.outerHTML;
                addToHistory('assistant', finalContent, html);
                scrollToBottom();
              } else {
                // 创建新消息（会在最后）
                appendOmnia(finalContent);
              }
            } else if (!omniaMsg) {
              appendOmnia('[未收到有效响应，请重试]');
            }
            
            // 最后才显示总结卡片（确认任务真正完成）
            // 只有在有实际内容输出时才显示
            if (data.show_summary && finalContent && finalContent.length > 10) {
              const toolCards = document.querySelectorAll('.tool-msg');
              if (toolCards.length > 0) {
                appendSummaryCard(toolCards.length);
              }
            }
            
            // 最后滚动到底部
            scrollToBottom(true);
          }

          else if (data.type === 'error') {
            removeTyping();
            appendOmnia(`[错误] ${data.message}`);
          }

        } catch (e) {
          console.error('Parse error:', e);
        }
      }
    }

    // 如果没有收到任何内容
    if (!omniaMsg && !currentContent) {
      removeTyping();
      appendOmnia('[意外] 未收到响应');
    }

  } catch (err) {
    removeTyping();
    appendOmnia(`[网络错误] ${err.message}`);
  } finally {
    composer.disabled = false;
