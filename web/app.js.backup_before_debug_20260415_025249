      linkLabel.style.color = 'var(--success)';
    } else {
      linkFill.style.width = '40%';
      linkFill.style.background = 'var(--danger)';
      linkLabel.textContent = 'LINK: WEAK';
      linkLabel.style.color = 'var(--danger)';
    }

    // 链路状态
    setLinkRow('link-daemon', data.daemon_running, data.daemon_running ? '在线' : '离线');
    setLinkRow('link-api', data.api_ready, data.api_ready ? '就绪' : '未配置');
