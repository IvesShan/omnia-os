// --- 加载状态 ---
async function loadStatus() {
  try {
    const res = await fetch(`${API_BASE}/api/status`);
    const data = await res.json();

    // 头像框
    const mem = data.memory || {};
    const totalMem = (mem.facts || 0) + (mem.relations || 0) + (mem.habits || 0) + (mem.timeline || 0);
    pulseIfChanged($('#mem-val'), String(totalMem));
    pulseIfChanged($('#skill-val'), String((data.skills || {}).total || 0));

    const allOk = data.daemon_running && data.api_ready;
    const linkFill = $('#link-strength');
