<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Omnia · 永不遗忘的操作系统</title>
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="styles.css" />
  <link rel="stylesheet" href="graph-viz.css" />
</head>
<body>
  <!-- 全局扫描线特效 -->
  <div class="scanlines"></div>

  <div class="app">
    <!-- 顶部 HUD 栏 -->
    <header class="top-bar">
      <div class="brand">
        <div class="logo-box">
          <svg class="wuxian-logo-xs" viewBox="0 0 64 64" width="36" height="36">
            <defs>
              <linearGradient id="wxGradXs" x1="0" y1="0" x2="64" y2="64">
                <stop offset="0%" stop-color="#22d3ee"/>
                <stop offset="100%" stop-color="#a855f7"/>
              </linearGradient>
            </defs>
            <path d="M32 12 L48 40 L16 40 Z" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linejoin="round" opacity="0.95"/>
            <path d="M20 33 L32 21 L44 33 M20 27 L32 39 L44 27"
                  fill="none" stroke="url(#wxGradXs)" stroke-width="3.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="32" cy="32" r="3.2" fill="#22d3ee"/>
          </svg>
        </div>
        <div class="brand-text">
          <div class="brand-title">OMNIA</div>
          <div class="brand-sub">永不遗忘的操作系统</div>
        </div>
      </div>

      <div class="top-center">
        <div class="clock" id="clock">00:00:00</div>
        <div class="clock-label">SYSTEM ONLINE</div>
      </div>

    </header>

    <!-- 主驾驶舱 -->
    <div class="cockpit">
      <!-- 左侧战术列 -->
      <aside class="tactical left">
        <section class="hud-panel" data-action="daemon">
          <div class="hud-header">
            <span class="hud-tag">SYS.LINK</span>
            <span class="hud-title">链路状态</span>
          </div>
          <div class="hud-body">
            <div class="link-row" id="link-daemon"><span class="link-dot"></span><span class="link-name">守护进程</span><span class="link-value">检测中…</span></div>
            <div class="link-row" id="link-api"><span class="link-dot"></span><span class="link-name">API 通道</span><span class="link-value">检测中…</span></div>
            <div class="link-row" id="link-ide"><span class="link-dot"></span><span class="link-name">IDE 桥接</span><span class="link-value">检测中…</span></div>
          </div>
        </section>

        <section class="hud-panel" data-action="memory">
          <div class="hud-header">
            <span class="hud-tag">MEM.PALACE</span>
            <span class="hud-title">记忆宫殿</span>
          </div>
          <div class="hud-body">
            <div class="memory-grid" id="memory-grid">
              <div class="mem-cell"><span class="num">—</span><span class="label">事实</span></div>
              <div class="mem-cell"><span class="num">—</span><span class="label">关系</span></div>
              <div class="mem-cell"><span class="num">—</span><span class="label">习惯</span></div>
              <div class="mem-cell"><span class="num">—</span><span class="label">时间线</span></div>
            </div>
          </div>
        </section>

        <section class="hud-panel" data-action="git">
          <div class="hud-header">
            <span class="hud-tag">GIT.OP</span>
            <span class="hud-title">Git 态势</span>
          </div>
          <div class="hud-body">
            <div class="git-row"><span class="git-label">分支</span><span class="git-val" id="git-branch">—</span></div>
            <div class="git-row"><span class="git-label">24h 提交</span><span class="git-val" id="git-commits">—</span></div>
            <div class="git-row"><span class="git-label">待提交</span><span class="git-val warn" id="git-dirty">—</span></div>
          </div>
        </section>

        <section class="hud-panel" data-action="env">
          <div class="hud-header">
            <span class="hud-tag">ENV.SNAP</span>
            <span class="hud-title">环境快照</span>
          </div>
          <div class="hud-body compact">
            <div class="env-row"><span class="env-label">HOST</span><span class="env-val" id="env-host">—</span></div>
            <div class="env-row"><span class="env-label">MODEL</span><span class="env-val" id="env-model">—</span></div>
            <div class="env-row"><span class="env-label">SHELL</span><span class="env-val" id="env-shell">—</span></div>
            <div class="env-row"><span class="env-label">OS</span><span class="env-val" id="env-os">—</span></div>
          </div>
        </section>

        <section class="hud-panel" data-action="quick">
          <div class="hud-header">
            <span class="hud-tag">QUICK.OP</span>
            <span class="hud-title">快捷操作</span>
          </div>
          <div class="hud-body">
            <div class="quick-btns">
              <button class="qbtn" onclick="doWake(event)">唤醒系统</button>
              <button class="qbtn" onclick="doOpenWorkspace(event)">打开工作区</button>
              <button class="qbtn" onclick="doReload(event)" style="grid-column: span 2">刷新状态</button>
            </div>
          </div>
        </section>

        <!-- 左下机体状态面板（大头像框） -->
        <div class="avatar-frame-large" id="avatar-frame">
          <div class="avatar-ring-large">
            <div class="avatar-core-large">
              <svg class="wuxian-logo-sm" viewBox="0 0 64 64" width="56" height="56">
                <defs>
                  <linearGradient id="wxGradSm" x1="0" y1="0" x2="64" y2="64">
                    <stop offset="0%" stop-color="#22d3ee"/>
                    <stop offset="100%" stop-color="#a855f7"/>
                  </linearGradient>
                  <filter id="wxGlowSm" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="1.4" result="blur"/>
                    <feMerge>
                      <feMergeNode in="blur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>
                </defs>
                <path d="M32 10 L50 42 L14 42 Z" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linejoin="round" opacity="0.95"/>
                <path d="M18 35 L32 21 L46 35 M18 27 L32 41 L46 27"
                      fill="none" stroke="url(#wxGradSm)" stroke-width="3.2"
                      stroke-linecap="round" stroke-linejoin="round" filter="url(#wxGlowSm)"/>
                <circle cx="32" cy="32" r="3" fill="#22d3ee" filter="url(#wxGlowSm)"/>
              </svg>
            </div>
          </div>
          <div class="avatar-info-large">
            <div class="avatar-name-large">INFINITE <span class="unit">机体</span></div>
            <div class="avatar-bar-large" title="链接强度">
              <div class="bar-track-large"><div class="bar-fill" id="link-strength" style="width: 100%"></div></div>
              <span class="bar-label-large" id="link-label">LINK: STRONG</span>
            </div>
            <div class="avatar-stats-large">
              <div class="a-stat"><span class="a-label">MEM</span><span class="a-val" id="mem-val">—</span></div>
              <div class="a-stat"><span class="a-label">SKILL</span><span class="a-val" id="skill-val">—</span></div>
            </div>
          </div>
        </div>
      </aside>

      <!-- 中央通讯中心 -->
      <main class="main">
        <div class="chat-scroll" id="chat-scroll">
          <div class="messages" id="messages">
            <div class="msg omnia">
              <div class="bubble">
                <p>欢迎来到 Omnia。我是与你共同成长的操作系统。</p>
                <p class="sub">从此刻起，我们所做的一切，我都会铭记。</p>
              </div>
              <div class="meta">Omnia · 刚刚</div>
            </div>
          </div>
        </div>

        <div class="input-area">
          <div class="composer">
            <input type="file" id="image-input" accept="image/*" style="display:none;">
            <button id="attach-btn" aria-label="上传图片" title="上传图片">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </button>
            <textarea id="composer" rows="1" placeholder="跟 Omnia 说点什么…"></textarea>
            <button id="stop-btn" aria-label="中止" style="display:none;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg></button>
            <button id="send-btn" aria-label="发送">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9"></polygon></svg>
            </button>
          </div>
          <div class="composer-hint">
            <kbd>Enter</kbd> 发送 · <kbd>Shift + Enter</kbd> 换行 · 点击 📷 上传图片
          </div>
          <div id="image-preview" class="image-preview" style="display:none;">
            <img id="preview-img" src="" alt="预览">
            <button id="remove-image" aria-label="删除图片">✕</button>
          </div>
        </div>
      </main>

      <!-- 右侧战术列 -->
      <aside class="tactical right">
        <!-- 神经图谱 - Omnia 的存在可视化 -->
        <section class="hud-panel neural-panel" data-action="neural-graph">
          <div class="hud-header">
            <span class="hud-tag">NEURAL.GRAPH</span>
            <span class="hud-title">神经图谱</span>
          </div>
          <div class="hud-body neural-body">
            <!-- 动态背景 - 呼吸环 -->
            <div class="neural-scene">
              <div class="neural-ring r1"></div>
              <div class="neural-ring r2"></div>
              <div class="neural-ring r3"></div>
              
              <!-- 图谱画布 -->
              <div class="graph-canvas" id="graph-canvas">
                <div class="graph-placeholder">点击加载图谱</div>
              </div>
              
              <!-- 思维火花粒子 -->
              <div class="neural-particles">
                <span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span>
              </div>
            </div>
            
            <!-- 统计数据 -->
            <div class="graph-stats" id="graph-stats">
              <span class="gs-item"><span class="gs-num" id="gs-nodes">—</span> 节点</span>
              <span class="gs-item"><span class="gs-num" id="gs-edges">—</span> 关系</span>
            </div>
            <!-- 图例 -->
            <div class="graph-legend">
              <span class="legend-item"><span class="legend-dot project"></span>项目</span>
              <span class="legend-item"><span class="legend-dot person"></span>人物</span>
              <span class="legend-item"><span class="legend-dot file"></span>文件</span>
              <span class="legend-item"><span class="legend-dot concept"></span>概念</span>
              <span class="legend-item"><span class="legend-dot date"></span>日期</span>
              <span class="legend-item"><span class="legend-dot location"></span>地点</span>
              <span class="legend-item"><span class="legend-dot unknown"></span>未知</span>
            </div>
            
            <!-- 状态指示 -->
            <div class="neural-status" id="neural-status">COGNITION ACTIVE</div>
          </div>
        </section>


        <section class="hud-panel" data-action="api-selector" id="api-panel">
          <div class="hud-header">
            <span class="hud-tag">API.SELECT</span>
            <span class="hud-title">模型选择</span>
          </div>
          <div class="hud-body compact">
            <div class="api-status" id="api-status">检测中…</div>
            <div class="api-list" id="api-list">
              <!-- API 选项将通过 JS 动态生成 -->
            </div>
          </div>
        </section>

        <section class="hud-panel" data-action="ide" id="ide-panel" style="opacity:.9">
          <div class="hud-header">
            <span class="hud-tag">IDE.CTX</span>
            <span class="hud-title">IDE 上下文</span>
          </div>
          <div class="hud-body">
            <div class="ide-file" id="ide-file">未连接</div>
            <div class="ide-pos" id="ide-pos">等待 IDE 信号…</div>
          </div>
        </section>

        <section class="hud-panel" data-action="system" id="sys-panel">
          <div class="hud-header">
            <span class="hud-tag">SYS.VITAL</span>
            <span class="hud-title">系统体征</span>
          </div>
          <div class="hud-body compact">
            <div class="vit-row" id="vit-cpu" style="display:none">
              <span class="vit-label">CPU</span>
              <div class="vit-bar"><div class="vit-fill" id="vit-cpu-fill"></div></div>
              <span class="vit-val" id="vit-cpu-val">—</span>
            </div>
            <div class="vit-row" id="vit-mem" style="display:none">
              <span class="vit-label">MEM</span>
              <div class="vit-bar"><div class="vit-fill" id="vit-mem-fill"></div></div>
              <span class="vit-val" id="vit-mem-val">—</span>
            </div>
            <div class="vit-row" id="vit-disk" style="display:none">
              <span class="vit-label">DISK</span>
              <div class="vit-bar"><div class="vit-fill" id="vit-disk-fill"></div></div>
              <span class="vit-val" id="vit-disk-val">—</span>
            </div>
            <div class="vit-row" id="vit-temp" style="display:none">
              <span class="vit-label">TEMP</span>
              <div class="vit-bar"><div class="vit-fill" id="vit-temp-fill"></div></div>
              <span class="vit-val" id="vit-temp-val">—</span>
            </div>
            <div class="vit-empty" id="vit-empty">暂无体征数据</div>
          </div>
        </section>

        <section class="hud-panel" data-action="notif" id="notif-panel" style="opacity:.9">
          <div class="hud-header">
            <span class="hud-tag">NOTIF</span>
            <span class="hud-title">通知中心</span>
          </div>
          <div class="hud-body" id="notif-list">
            <div class="notif-item" style="opacity:.7"><span class="notif-dot info"></span><div class="notif-title">暂无新通知</div></div>
          </div>
        </section>

        <section class="hud-panel" data-action="skills">
          <div class="hud-header">
            <span class="hud-tag">SKILL.MTX</span>
            <span class="hud-title">技能矩阵</span>
          </div>
          <div class="hud-body compact">
            <div class="skill-total">
              <span class="sk-num" id="sk-total">—</span>
              <span class="sk-label">已装载技能</span>
            </div>
            <div class="skill-sub">
              <span class="sk-badge" id="sk-auto">自动锻造: —</span>
            </div>
          </div>
        </section>

        <section class="hud-panel" data-action="memory-search">
          <div class="hud-header">
            <span class="hud-tag">MEM.SEARCH</span>
            <span class="hud-title">记忆搜索</span>
          </div>
          <div class="hud-body compact">
            <div class="mem-search-row">
              <input type="text" id="mem-search-input" placeholder="搜索记忆…" />
              <button id="mem-search-btn">搜</button>
            </div>
            <div class="mem-search-results" id="mem-search-results"></div>
          </div>
        </section>


        <section class="hud-panel" data-action="workflow">
          <div class="hud-header">
            <span class="hud-tag">WORKFLOW</span>
            <span class="hud-title">一键工作流</span>
          </div>
          <div class="hud-body">
            <div class="workflow-grid">
              <button class="wfbtn" onclick="runWorkflow('git-status', event)">
                <span class="wficon">🌿</span>
                <span class="wflabel">Git 状态</span>
              </button>
              <button class="wfbtn" onclick="runWorkflow('backup-workspace', event)">
                <span class="wficon">💾</span>
                <span class="wflabel">备份空间</span>
              </button>
              <button class="wfbtn" onclick="runWorkflow('seo-deploy', event)">
                <span class="wficon">🚀</span>
                <span class="wflabel">部署 SEO</span>
              </button>
              <button class="wfbtn" onclick="runWorkflow('courseware-check', event)">
                <span class="wficon">📚</span>
                <span class="wflabel">课件统计</span>
              </button>
            </div>
          </div>
        </section>

      </aside>
    </div>
  </div>

  <!-- 安全确认弹窗 -->
  <div class="confirm-overlay" id="confirm-overlay" style="display:none">
    <div class="confirm-card">
      <div class="confirm-title">需要你的确认</div>
      <div class="confirm-body" id="confirm-body">Omnia 请求执行一个操作。</div>
      <div class="confirm-actions">
        <button class="btn-deny" id="btn-deny">取消</button>
        <button class="btn-allow" id="btn-allow">允许执行</button>
      </div>
    </div>
  </div>

  <script src="app.js"></script>
  <script src="graph-viz.js"></script>
  <script src="health_check.js"></script>
</body>
</html>
