// --- 自动滚动修复 ---
// 注意：userScrolledUp 已在文件开头声明，这里不需要重复声明
scrollEl.addEventListener('scroll', () => {
  const threshold = 40;
  userScrolledUp = scrollEl.scrollTop + scrollEl.clientHeight < scrollEl.scrollHeight - threshold;
});

// 覆盖原来的 scrollToBottom
const originalScrollToBottom = scrollToBottom;
scrollToBottom = function (force = false) {
  if (userScrolledUp && !force) {
    showNewMessageIndicator();
    return;
  }
  scrollEl.scrollTo({ top: scrollEl.scrollHeight, behavior: 'smooth' });
  hideNewMessageIndicator();
};
;

// --- 复制到剪贴板 ---
async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch (e) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      document.body.removeChild(ta);
      return true;
    } catch (err) {
      document.body.removeChild(ta);
      return false;
    }
  }
}

messagesEl.addEventListener('click', async (e) => {
  const btn = e.target.closest('.copy-btn');
  if (!btn) return;
  const raw = btn.dataset.copyText || '';
  const ok = await copyToClipboard(raw);
  const original = btn.textContent;
  btn.textContent = ok ? '已复制' : '失败';
  setTimeout(() => { btn.textContent = original; }, 1500);
});

// --- 浏览器通知 ---
if ('Notification' in window) {
  Notification.requestPermission().catch(() => {});
}
function notifyUser(title, body) {
  if (!('Notification' in window)) return;
  if (Notification.permission === 'granted' && document.hidden) {
    new Notification(title, { body });
  }
}

// --- 安全确认弹窗 ---
const confirmOverlay = $('#confirm-overlay');
const confirmBody = $('#confirm-body');
const btnDeny = $('#btn-deny');
const btnAllow = $('#btn-allow');
let pendingConfirmId = null;
const PENDING_CONFIRM_KEY = 'omnia_pending_confirm_v1';

function showConfirm(data) {
  pendingConfirmId = data.confirm_id;
  try {
    localStorage.setItem(PENDING_CONFIRM_KEY, JSON.stringify(data));
  } catch (e) {
    // ignore
  }
  const tool = data.tool || 'unknown';
  const argText = JSON.stringify(data.arguments || {}).slice(0, 120);
  confirmBody.innerHTML = `
    <div style="margin-bottom:6px; font-weight:600; color:var(--warn);">⚠️ ${escapeHtml(data.reason || '该操作需要确认')}</div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text);">Tool: ${escapeHtml(tool)}</div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-secondary); margin-top:4px;">Args: ${escapeHtml(argText)}${argText.length >= 120 ? '...' : ''}</div>
  `;
  confirmOverlay.style.display = 'flex';
}

function hideConfirm() {
  confirmOverlay.style.display = 'none';
  pendingConfirmId = null;
  try {
    localStorage.removeItem(PENDING_CONFIRM_KEY);
  } catch (e) {
    // ignore
  }
}

async function submitConfirm(approved) {
  let confirmId = pendingConfirmId;
  if (!confirmId) {
    try {
      const raw = localStorage.getItem(PENDING_CONFIRM_KEY);
      if (raw) {
        const cached = JSON.parse(raw);
        confirmId = cached.confirm_id;
        console.log('[submitConfirm] recovered cid from localStorage:', confirmId);
      }
    } catch (e) {
      // ignore
    }
  }
  if (!confirmId) {
    console.log('[submitConfirm] skipped: no pendingConfirmId');
    appendOmnia('[错误] 找不到待确认的操作，可能页面已刷新或状态已过期。');
    return;
  }
  console.log('[submitConfirm] cid=', confirmId, 'approved=', approved);
  hideConfirm();
  btnAllow.disabled = true;
  btnDeny.disabled = true;
  if (!approved) {
    appendOmnia('[已取消] 你拒绝了该操作的执行。');
    btnAllow.disabled = false;
    btnDeny.disabled = false;
    return;
  }
  showTyping();
  try {
    const res = await fetch(`${API_BASE}/api/confirm`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ confirm_id: confirmId, approved: true }),
    });
    removeTyping();
    const data = await res.json();
    if (data.steps && data.steps.length) {
      for (const s of data.steps) {
        appendToolStep(s.tool, s.arguments, s.result_summary || '', s.status);
      }
    }
    if (data.reply) {
      appendOmnia(data.reply);
    } else if (data.error) {
      appendOmnia(`[错误] ${data.error}`);
    } else {
      appendOmnia('[意外响应]');
    }
  } catch (err) {
    removeTyping();
    appendOmnia(`[网络错误] ${err.message}`);
  } finally {
    btnAllow.disabled = false;
    btnDeny.disabled = false;
  }
}

btnDeny.addEventListener('click', () => submitConfirm(false));
btnAllow.addEventListener('click', () => submitConfirm(true));

function restorePendingConfirm() {
  try {
    const raw = localStorage.getItem(PENDING_CONFIRM_KEY);
    if (raw) {
      const data = JSON.parse(raw);
      if (data && data.confirm_id) {
        showConfirm(data);
        console.log('[restorePendingConfirm] restored cid=', data.confirm_id);
      }
    }
  } catch (e) {
    localStorage.removeItem(PENDING_CONFIRM_KEY);
  }
}

// --- 记忆搜索 ---
const memSearchInput = $('#mem-search-input');
const memSearchBtn = $('#mem-search-btn');
const memSearchResults = $('#mem-search-results');

async function doMemorySearch() {
  const q = memSearchInput.value.trim();
  if (!q) return;
  memSearchResults.innerHTML = '<div class="mem-result"><div class="mem-snippet">搜索中…</div></div>';
  try {
    const res = await fetch(`${API_BASE}/api/memory/search`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: q }),
    });
    const data = await res.json();
    const results = data.results || [];
    if (!results.length) {
      memSearchResults.innerHTML = '<div class="mem-result"><div class="mem-snippet">未找到相关记忆</div></div>';
      return;
    }
    memSearchResults.innerHTML = results.map(r => `
      <div class="mem-result ${escapeHtml(r.layer)}">
        <div class="mem-layer">${escapeHtml(r.layer)}</div>
        <div class="mem-snippet">${escapeHtml(r.snippet)}</div>
      </div>
    `).join('');
  } catch (err) {
    memSearchResults.innerHTML = `<div class="mem-result"><div class="mem-snippet">搜索失败: ${escapeHtml(err.message)}</div></div>`;
  }
}

memSearchBtn.addEventListener('click', doMemorySearch);
memSearchInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') doMemorySearch();
});

// --- API 选择器 ---
let currentApiProvider = null;

async function loadApiProviders() {
  const apiStatus = $('#api-status');
  const apiList = $('#api-list');
  
  try {
    const res = await fetch(`${API_BASE}/api/providers`);
    const data = await res.json();
    const providers = data.providers || [];
    const active = data.active;
    
    if (!providers.length) {
      apiStatus.textContent = '未配置 API';
      apiList.innerHTML = '<div style="color:var(--text-secondary);font-size:11px;padding:8px;">请在 .env 文件中配置 API Key</div>';
      return;
    }
    
    currentApiProvider = active;
    apiStatus.textContent = `当前: ${getProviderName(active)}`;
    apiStatus.classList.add('active');
    
    apiList.innerHTML = providers.map(p => `
      <div class="api-item ${p.id === active ? 'selected' : ''} ${p.configured ? '' : 'disabled'}" 
           data-provider="${p.id}" 
           onclick="selectProvider('${p.id}', ${p.configured})">
        <div class="api-dot ${p.configured ? p.id : 'disabled'}"></div>
        <div class="api-info">
          <div class="api-name">${p.name} ${p.id === active ? '<span class="badge">使用中</span>' : ''}</div>
          <div class="api-model">${p.model}</div>
        </div>
      </div>
    `).join('');
  } catch (err) {
    apiStatus.textContent = '加载失败';
    apiList.innerHTML = `<div style="color:var(--danger);font-size:11px;padding:8px;">错误: ${escapeHtml(err.message)}</div>`;
  }
}

function getProviderName(id) {
  const names = {
    local: '本地 GPU',
    deepseek: 'DeepSeek',
    qianfan: '百度千帆',
    kimi: 'Moonshot',
    openai: 'OpenAI',
    xiaomi: '小米 MiMo',
    anthropic: 'Anthropic'
  };
  return names[id] || id;
}

async function selectProvider(providerId, configured) {
  if (!configured) {
    alert('该 API 未配置，请在 .env 文件中添加对应的 API Key');
    return;
  }
  
  try {
    const res = await fetch(`${API_BASE}/api/providers`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ provider: providerId })
    });
    
    if (res.ok) {
      currentApiProvider = providerId;
      loadApiProviders(); // 刷新列表
      appendOmnia(`[系统] 已切换到: ${getProviderName(providerId)}`);
    } else {
      const data = await res.json();
      alert('切换失败: ' + (data.error || '未知错误'));
    }
  } catch (err) {
    alert('切换失败: ' + err.message);
  }
}

// --- 初始化 ---
restorePendingConfirm();
loadStatus();
loadApiProviders();

// 状态刷新节流 - 页面不可见时跳过
let statusIntervalId = null;
function scheduleStatusRefresh() {
  // 后台标签页也定期刷新（每60秒），防止连接断开后UI卡死
  // 前台标签页保持15秒间隔（由 setInterval 控制）
  if (document.hidden) {
    // 后台标签页：静默刷新，不用 requestIdleCallback
    loadStatus();
    return;
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => loadStatus(), { timeout: 20000 });
  } else {
    loadStatus();
  }
}
setInterval(scheduleStatusRefresh, 15000);
// 后台标签页更慢的刷新间隔（60秒），减少资源消耗
setInterval(() => {
  if (document.hidden && typeof loadStatus === 'function') {
    loadStatus();
  }
}, 60000);

setInterval(loadApiProviders, 60000); // 每分钟刷新 API 列表

// 心跳检测 - 每 30 秒检查连接状态（防止待机后静默断连）
setInterval(heartbeatPing, 30000);
composer.focus();

// =========================================
// 斜杠命令菜单系统
// =========================================

const SLASH_COMMANDS = [
  { cmd: '/stop', desc: '中止当前思考', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>', action: 'stopThinking' },
  { cmd: '/clear', desc: '清空聊天历史', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>', action: 'clearChat' },
  { cmd: '/export', desc: '导出聊天记录', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>', action: 'exportChat' },
  { cmd: '/status', desc: '显示系统状态', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>', action: 'showStatus' },
  { cmd: '/help', desc: '显示所有命令', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>', action: 'showHelp' },
  { cmd: '/model', desc: '切换 AI 模型', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>', action: 'switchModel' },
  { cmd: '/memory', desc: '搜索记忆宫殿', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>', action: 'searchMemory' },
  { cmd: '/theme', desc: '切换主题', icon: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>', action: 'switchTheme' },
];

let commandMenuVisible = false;
let commandMenuEl = null;
let selectedCommandIndex = 0;
let filteredCommands = [];

// 创建命令菜单元素
function createCommandMenu() {
  if (commandMenuEl) return;
  
  commandMenuEl = document.createElement('div');
  commandMenuEl.id = 'slash-command-menu';
  commandMenuEl.className = 'slash-command-menu';
  commandMenuEl.style.display = 'none';
  document.body.appendChild(commandMenuEl);
  
  // 点击外部关闭
  document.addEventListener('click', (e) => {
    if (commandMenuVisible && !commandMenuEl.contains(e.target) && e.target !== composer) {
      hideCommandMenu();
    }
  });
}

// 显示命令菜单
function showCommandMenu(filter = '') {
  if (!commandMenuEl) createCommandMenu();
  
  filteredCommands = SLASH_COMMANDS.filter(c => 
    c.cmd.toLowerCase().includes(filter.toLowerCase()) ||
    c.desc.toLowerCase().includes(filter.toLowerCase())
  );
  
  if (filteredCommands.length === 0) {
    hideCommandMenu();
    return;
  }
  
  selectedCommandIndex = 0;
  renderCommandMenu();
  
  // 定位菜单
  const rect = composer.getBoundingClientRect();
  commandMenuEl.style.bottom = (window.innerHeight - rect.top + 8) + 'px';
  commandMenuEl.style.left = rect.left + 'px';
  commandMenuEl.style.width = Math.min(320, rect.width) + 'px';
  commandMenuEl.style.display = 'block';
  commandMenuVisible = true;
}

// 渲染命令菜单内容
function renderCommandMenu() {
  if (!commandMenuEl) return;
  
  commandMenuEl.innerHTML = filteredCommands.map((c, i) => `
    <div class="slash-cmd-item ${i === selectedCommandIndex ? 'selected' : ''}" 
         data-index="${i}" 
         data-action="${c.action}">
      <span class="slash-cmd-icon">${c.icon}</span>
      <div class="slash-cmd-info">
        <div class="slash-cmd-name">${escapeHtml(c.cmd)}</div>
        <div class="slash-cmd-desc">${escapeHtml(c.desc)}</div>
      </div>
    </div>
  `).join('');
  
  // 绑定点击事件
  commandMenuEl.querySelectorAll('.slash-cmd-item').forEach(item => {
    item.addEventListener('click', () => {
      const index = parseInt(item.dataset.index);
      executeCommand(filteredCommands[index]);
    });
  });
}

// 隐藏命令菜单
function hideCommandMenu() {
  if (commandMenuEl) {
    commandMenuEl.style.display = 'none';
  }
  commandMenuVisible = false;
}

// 执行命令
function executeCommand(cmdObj) {
  hideCommandMenu();
  composer.value = '';  // 清空输入框
  
  switch (cmdObj.action) {
    case 'stopThinking':
      stopThinking();
      break;
    case 'clearChat':
      clearChatHistory();
      break;
    case 'exportChat':
      exportChatHistory();
      break;
    case 'showStatus':
      showSystemStatus();
      break;
    case 'showHelp':
      showHelpInfo();
      break;
    case 'switchModel':
      showModelSwitcher();
      break;
    case 'searchMemory':
      focusMemorySearch();
      break;
    case 'switchTheme':
      toggleTheme();
      break;
  }
}

// 命令实现
function stopThinking() {
  // 中止当前请求
  if (window.currentAbortController) {
    window.currentAbortController.abort();
    appendOmnia('[系统] 已中止当前思考。');
  } else {
    appendOmnia('[系统] 当前没有正在进行的思考。');
  }
  removeTyping();
}

function clearChatHistory() {
  if (confirm('确定要清空所有聊天记录吗？此操作不可撤销。')) {
    chatHistory = [];
    localStorage.removeItem(CHAT_KEY);
    messagesEl.innerHTML = `
      <div class="msg omnia">
        <div class="bubble">
          <p>聊天记录已清空。有什么新话题想聊吗？</p>
        </div>
        <div class="meta">Omnia · 刚刚</div>
      </div>
    `;
  }
}

function exportChatHistory() {
  if (chatHistory.length === 0) {
    appendOmnia('[系统] 没有聊天记录可导出。');
    return;
  }
  
  const exportData = chatHistory.map(m => ({
    role: m.role,
    content: m.content,
    time: new Date(m.time).toLocaleString('zh-CN')
  }));
  
  const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `omnia-chat-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
  
  appendOmnia('[系统] 聊天记录已导出为 JSON 文件。');
}

function showSystemStatus() {
  loadStatus();
  appendOmnia('[系统] 系统状态已刷新，请查看左侧面板。');
}

function showHelpInfo() {
  const helpText = SLASH_COMMANDS.map(c => `${c.cmd} - ${c.desc}`).join('\n');
  appendOmnia(`[帮助] 可用的斜杠命令：\n\n${helpText}\n\n提示：输入 / 后会自动显示命令菜单，可以用 ↑↓ 键选择，Enter 确认。`);
}

function showModelSwitcher() {
  const apiPanel = $('#api-panel');
  if (apiPanel) {
    apiPanel.scrollIntoView({ behavior: 'smooth' });
    apiPanel.style.boxShadow = '0 0 20px rgba(34,211,238,0.5)';
    setTimeout(() => {
      apiPanel.style.boxShadow = '';
    }, 2000);
  }
  appendOmnia('[系统] 请在右侧面板选择 AI 模型。');
}

function focusMemorySearch() {
  const memInput = $('#mem-search-input');
  if (memInput) {
    memInput.focus();
    memInput.scrollIntoView({ behavior: 'smooth' });
  }
  appendOmnia('[系统] 已聚焦到记忆搜索框，请输入关键词搜索。');
}

function toggleTheme() {
  // 预留：主题切换功能
  appendOmnia('[系统] 主题切换功能开发中，敬请期待...');
}

// 监听输入框
composer.addEventListener('input', (e) => {
  const value = composer.value;
  
  if (value.startsWith('/')) {
    const filter = value.slice(1);  // 去掉斜杠
    showCommandMenu(filter);
  } else {
    hideCommandMenu();
  }
});

// 键盘导航
composer.addEventListener('keydown', (e) => {
  if (!commandMenuVisible) return;
  
  if (e.key === 'ArrowDown') {
    e.preventDefault();
    selectedCommandIndex = Math.min(selectedCommandIndex + 1, filteredCommands.length - 1);
    renderCommandMenu();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    selectedCommandIndex = Math.max(selectedCommandIndex - 1, 0);
    renderCommandMenu();
  } else if (e.key === 'Tab' || (e.key === 'Enter' && !e.shiftKey)) {
    e.preventDefault();
    if (filteredCommands[selectedCommandIndex]) {
      executeCommand(filteredCommands[selectedCommandIndex]);
    }
  } else if (e.key === 'Escape') {
    hideCommandMenu();
  }
});

// 初始化
createCommandMenu();

console.log('[Slash Commands] 斜杠命令菜单已加载');

// =========================================
// 中止控制器支持（用于 /stop 命令）
// =========================================

// 保存原始的 sendMessage
const originalSendMessage = sendMessage;

// 重写 sendMessage，添加 AbortController 支持
sendMessage = async function() {
  // 创建 AbortController
  window.currentAbortController = new AbortController();
  
  try {
    await originalSendMessage();
  } catch (err) {
    if (err.name === 'AbortError') {
      console.log('[sendMessage] 请求已被用户中止');
    } else {
      throw err;
    }
  } finally {
    window.currentAbortController = null;
  }
};

console.log('[AbortController] 中止控制器已启用');


// ========== 中止按钮逻辑 ==========
const sendBtnEl = document.getElementById('send-btn');
const stopBtn = document.getElementById('stop-btn');

// 显示/隐藏按钮
function showStopButton(show) {
  if (sendBtnEl) sendBtnEl.style.display = show ? 'none' : 'flex';
  if (stopBtn) stopBtn.style.display = show ? 'flex' : 'none';
}

// 中止按钮点击事件
if (stopBtn) {
  stopBtn.addEventListener('click', () => {
    if (window.currentAbortController) {
      console.log('[中止] 用户点击中止按钮');
      window.currentAbortController.abort();
      showStopButton(false);
      removeTyping();
      
      // 在消息中添加中止提示
      const messages = document.getElementById('messages');
      if (messages) {
        const abortMsg = document.createElement('div');
        abortMsg.className = 'message omnia';
        abortMsg.innerHTML = '<div class="bubble"><p style="color: #f59e0b;">⚠️ 思考已中止</p></div>';
        messages.appendChild(abortMsg);
        scrollToBottom();
      }
    }
  });
}

// 监控流式状态
const originalShowTyping = showTyping;
showTyping = function(text) {
  showStopButton(true);
  return originalShowTyping(text);
};

const originalRemoveTyping = removeTyping;
removeTyping = function() {
  showStopButton(false);
  return originalRemoveTyping();
};

console.log('[中止按钮] 已初始化');

// =========================================

// =========================================
// Token 状态管理
// =========================================

let currentTokenStatus = {
  total_tokens: 0,
  max_tokens: 128000,
  utilization: 0,
  status: 'empty'
};

// 更新 Token 状态显示
function updateTokenDisplay(status) {
  currentTokenStatus = status;
  
  const tokenStatus = document.getElementById('token-status');
  const tokenFill = document.getElementById('token-fill');
  const tokenValue = document.getElementById('token-value');
  
  if (!tokenStatus || !tokenFill || !tokenValue) return;
  
  const percent = Math.round(status.utilization);
  
  // 更新进度条
  tokenFill.style.width = `${percent}%`;
  tokenValue.textContent = `${percent}%`;
  
  // 更新状态样式
  tokenStatus.classList.remove('warning', 'danger');
  
  if (percent >= 90) {
    tokenStatus.classList.add('danger');
    tokenValue.title = `⚠️ 上下文即将溢出！已用 ${status.total_tokens} / ${status.max_tokens} tokens`;
  } else if (percent >= 70) {
    tokenStatus.classList.add('warning');
    tokenValue.title = `⚡ 上下文使用率较高：${status.total_tokens} / ${status.max_tokens} tokens`;
  } else {
    tokenValue.title = `✓ 上下文正常：${status.total_tokens} / ${status.max_tokens} tokens`;
  }
  
  // 显示/隐藏
  tokenStatus.style.display = status.status === 'empty' ? 'none' : 'flex';
}

// 检查 Token 状态
async function checkTokenStatus() {
  // 从 chatHistory 构建消息列表
  const messages = chatHistory.slice(-50).map(m => ({
    role: m.role,
    content: m.content
  }));
  
  if (messages.length === 0) {
    updateTokenDisplay({ total_tokens: 0, utilization: 0, status: 'empty' });
    return;
  }
  
  try {
    const response = await fetch(`${API_BASE}/api/token/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: messages, model: currentApiProvider || 'deepseek' })
    });
    
    if (response.ok) {
      const status = await response.json();
      updateTokenDisplay(status);
    }
  } catch (e) {
    console.log('[Token Status] Check failed:', e);
  }
}

// 每次聊天历史变化时检查
const originalSaveChatHistory = saveChatHistory;
saveChatHistory = function() {
  originalSaveChatHistory();
  // 延迟检查，避免频繁请求
  setTimeout(checkTokenStatus, 100);
};

// 页面加载时检查一次
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(checkTokenStatus, 500);
});
