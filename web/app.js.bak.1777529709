const API_BASE = `${window.location.origin}`;

// =========================================
// 性能优化模块
// =========================================

// 页面可见性感知 - 后台暂停动画
// =========================================
// 连接状态追踪
// =========================================
let isPageVisible = true;
let connectionState = 'unknown';  // 'connected' | 'disconnected' | 'unknown'
let lastSuccessfulPing = 0;
let consecutiveFailures = 0;

function setConnectionState(state) {
  const prevState = connectionState;
  connectionState = state;
  
  // 更新 UI 指示器
  const indicator = document.getElementById('connection-banner');
  if (state === 'disconnected') {
    if (!indicator) {
      const banner = document.createElement('div');
      banner.id = 'connection-banner';
      banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:rgba(239,68,68,0.9);color:white;text-align:center;padding:6px 0;font-size:13px;font-family:system-ui;backdrop-filter:blur(8px);transition:opacity 0.3s;';
      banner.textContent = '⚠️ 与服务器的连接已断开，正在重连…';
      document.body.appendChild(banner);
    }
  } else if (state === 'connected') {
    if (indicator) {
      indicator.style.opacity = '0';
      setTimeout(() => indicator.remove(), 300);
    }
    if (prevState === 'disconnected') {
      console.log('[Connection] 已恢复连接');
    }
  }
}

// 带超时的 fetch（防止请求挂起导致 UI 卡死）
async function fetchWithTimeout(url, options = {}, timeoutMs = 8000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const response = await fetch(url, { ...options, signal: controller.signal });
    clearTimeout(timer);
    return response;
  } catch (err) {
    clearTimeout(timer);
    throw err;
  }
}

// 心跳检测 - 轻量级 ping
async function heartbeatPing() {
  try {
    const res = await fetchWithTimeout(`${API_BASE}/api/status`, {}, 5000);
    if (res.ok) {
      lastSuccessfulPing = Date.now();
      consecutiveFailures = 0;
      setConnectionState('connected');
      return true;
    }
  } catch (e) {
    // 静默失败
  }
  consecutiveFailures++;
  if (consecutiveFailures >= 3) {
    setConnectionState('disconnected');
  }
  return false;
}

// 页面可见性感知 - V2（修复待机后 UI 卡死）
document.addEventListener('visibilitychange', () => {
  isPageVisible = !document.hidden;
  if (document.hidden) {
    document.body.classList.add('page-hidden');
  } else {
    document.body.classList.remove('page-hidden');
    console.log('[Visibility] 页面恢复可见，执行恢复序列');
    
    // 1. 强制重新布局（解决渲染死锁）
    if (messagesEl) {
      messagesEl.style.display = 'none';
      messagesEl.offsetHeight;  // 强制重排
      messagesEl.style.display = '';
    }
    
    // 2. 立即心跳检测
    heartbeatPing().then(ok => {
      if (ok) {
        // 3. 连接正常，刷新所有状态
        if (typeof loadStatus === 'function') loadStatus();
        if (typeof loadApiProviders === 'function') loadApiProviders();
        // 4. 恢复滚动位置
        if (scrollEl) scrollEl.scrollTop = scrollEl.scrollHeight;
      } else {
        // 5. 连接失败，进入重连循环
        console.warn('[Visibility] 心跳失败，进入重连模式');
        reconnectLoop();
      }
    });
  }
});

// 指数退避重连
async function reconnectLoop() {
  let delay = 2000;
  const maxDelay = 30000;
  
  while (connectionState === 'disconnected') {
    console.log(`[Reconnect] ${delay/1000}s 后重试...`);
    await new Promise(r => setTimeout(r, delay));
    
    const ok = await heartbeatPing();
    if (ok) {
      // 恢复后刷新页面状态
      if (typeof loadStatus === 'function') loadStatus();
      if (typeof loadApiProviders === 'function') loadApiProviders();
      return;
    }
    delay = Math.min(delay * 1.5, maxDelay);
  }
}

// 滚动节流
let scrollPending = false;
function scheduleScrollToBottom() {
  if (scrollPending) return;
  scrollPending = true;
  requestAnimationFrame(() => {
    scrollToBottom();
    scrollPending = false;
  });
}

// 时钟优化 - 使用 rAF
let lastClockUpdate = 0;
function clockLoop(timestamp) {
  if (!isPageVisible) {
    requestAnimationFrame(clockLoop);
    return;
  }
  if (timestamp - lastClockUpdate >= 1000) {
    updateClock();
    lastClockUpdate = timestamp;
  }
  requestAnimationFrame(clockLoop);
}


const CHAT_KEY = 'omnia_chat_history_v1';
const MAX_CHAT_HISTORY = 200;

const $ = (s) => document.querySelector(s);
const messagesEl = $('#messages');
const scrollEl = $('#chat-scroll');
const composer = $('#composer');
const sendBtn = $('#send-btn');
const attachBtn = $('#attach-btn');
const imageInput = $('#image-input');
const imagePreview = $('#image-preview');
const previewImg = $('#preview-img');
const removeImageBtn = $('#remove-image');

let chatHistory = [];
let userScrolledUp = false;  // 用户是否在查看历史消息
let selectedImage = null;    // 当前选中的图片（base64）
try {
  const raw = localStorage.getItem(CHAT_KEY);
  if (raw) {
    const parsed = JSON.parse(raw);
    // 过滤掉旧格式数据，只保留有 role 和 content 的
    chatHistory = parsed.filter(m => m.role && m.content);
  }
} catch (e) {
  chatHistory = [];
}

// 页面加载时立即恢复聊天历史

// 确保 DOM 加载完成后再绑定事件
document.addEventListener('DOMContentLoaded', () => {
    renderChatFromStorage();
  document.querySelectorAll('.hud-panel').forEach((panel) => {
    panel.addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
      if (e.target.closest(".api-item")) return;  // 让 api-item 自己处理点击
      const action = panel.dataset.action;
      if (action) handlePanelClick(action);
    });
  });
});

function renderChatFromStorage() {
  console.log("[Chat History Debug] renderChatFromStorage 被调用, chatHistory.length =", chatHistory.length);
  console.log("[Chat History Debug] localStorage 内容:", localStorage.getItem(CHAT_KEY)?.slice(0, 200));
  messagesEl.innerHTML = '';
  for (const item of chatHistory) {
    if (item.html) {
      messagesEl.insertAdjacentHTML('beforeend', item.html);
    }
  }
  scrollToBottom();
}

function saveChatHistory() {
  if (chatHistory.length > MAX_CHAT_HISTORY) {
    chatHistory = chatHistory.slice(-MAX_CHAT_HISTORY);
  }
  localStorage.setItem(CHAT_KEY, JSON.stringify(chatHistory));
}

function addToHistory(role, content, html) {
  chatHistory.push({
    role: role,  // 'user' or 'assistant'
    content: content,  // 纯文本内容
    html: html,  // 渲染后的 HTML
    time: Date.now()
  });
  saveChatHistory();
}

// pushChat 已废弃，统一使用 addToHistory

// --- 时钟 ---
// 改用 requestAnimationFrame，减少 CPU 消耗
let clockEl = null;
function updateClock() {
  if (!clockEl) clockEl = $('#clock');
  if (!clockEl) return;
  const now = new Date();
  const h = String(now.getHours()).padStart(2, '0');
  const m = String(now.getMinutes()).padStart(2, '0');
  const s = String(now.getSeconds()).padStart(2, '0');
  clockEl.textContent = `${h}:${m}:${s}`;
}
requestAnimationFrame(clockLoop); updateClock();  // 立即执行一次

// --- 自动调整输入框高度 ---
function autoResize() {
  composer.style.height = 'auto';
  composer.style.height = Math.min(160, composer.scrollHeight) + 'px';
}
composer.addEventListener('input', autoResize);

composer.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});
sendBtn.addEventListener('click', sendMessage);

// --- 图片上传 ---
attachBtn.addEventListener('click', () => imageInput.click());

imageInput.addEventListener('change', (e) => {
  const file = e.target.files[0];
  if (!file) return;
  
  // 验证文件类型
  if (!file.type.startsWith('image/')) {
    alert('请选择图片文件');
    return;
  }
  
  // 验证文件大小（最大 5MB）
  if (file.size > 5 * 1024 * 1024) {
    alert('图片大小不能超过 5MB');
    return;
  }
  
  // 读取图片为 base64
  const reader = new FileReader();
  reader.onload = (event) => {
    selectedImage = event.target.result;
    previewImg.src = selectedImage;
    imagePreview.style.display = 'flex';
  };
  reader.readAsDataURL(file);
});

removeImageBtn.addEventListener('click', () => {
  selectedImage = null;
  imageInput.value = '';
  imagePreview.style.display = 'none';
});


// 改进的剪贴板粘贴图片功能 - 带调试日志和视觉反馈
// 将此代码替换 app.js 中的粘贴事件处理部分

console.log('[Paste] 初始化粘贴图片功能...');

// --- 剪贴板粘贴图片（改进版）---
composer.addEventListener('paste', (e) => {
  console.log('[Paste] 粘贴事件触发');
  console.log('[Paste] clipboardData:', e.clipboardData);
  
  const items = e.clipboardData?.items;
  if (!items) {
    console.log('[Paste] 没有 clipboardData.items');
    return;
  }
  
  console.log('[Paste] items 数量:', items.length);
  
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    console.log(`[Paste] Item ${i}:`, item.type, item.kind);
    
    if (item.type.startsWith('image/')) {
      e.preventDefault();
      console.log('[Paste] 检测到图片，阻止默认行为');
      
      const file = item.getAsFile();
      if (!file) {
        console.log('[Paste] 无法获取文件');
        continue;
      }
      
      console.log('[Paste] 文件信息:', file.name, file.type, file.size, 'bytes');
      
      // 验证文件大小（最大 5MB）
      if (file.size > 5 * 1024 * 1024) {
        alert('图片大小不能超过 5MB');
        return;
      }
      
      // 读取图片为 base64
      const reader = new FileReader();
      reader.onload = (event) => {
        console.log('[Paste] 图片读取成功');
        selectedImage = event.target.result;
        previewImg.src = selectedImage;
        imagePreview.style.display = 'flex';
        
        // 添加视觉反馈 - 按钮闪烁
        attachBtn.style.color = 'var(--cyan)';
        attachBtn.style.transform = 'scale(1.2)';
        setTimeout(() => {
          attachBtn.style.color = '';
          attachBtn.style.transform = '';
        }, 800);
        
        console.log('[Paste] 图片预览已显示');
      };
      reader.onerror = (err) => {
        console.error('[Paste] FileReader 错误:', err);
        alert('图片读取失败，请重试');
      };
      reader.readAsDataURL(file);
      break;  // 只处理第一个图片
    }
  }
});

// --- 全局粘贴监听（当焦点不在 composer 时）---
document.addEventListener('paste', (e) => {
  // 如果焦点不在 composer 上，但粘贴的是图片，聚焦到 composer
  if (document.activeElement !== composer) {
    const items = e.clipboardData?.items;
    if (!items) return;
    
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        console.log('[Paste] 全局监听检测到图片粘贴，聚焦到 composer');
        composer.focus();
        break;
      }
    }
  }
});

console.log('[Paste] 粘贴图片功能初始化完成');

// --- 滚动监听 ---
scrollEl.addEventListener('scroll', () => {
  const { scrollTop, scrollHeight, clientHeight } = scrollEl;
  const isNearBottom = scrollHeight - scrollTop - clientHeight < 100;  // 距离底部 100px 内算"在底部"
  
  if (isNearBottom) {
    userScrolledUp = false;
    hideNewMessageIndicator();
  } else {
    userScrolledUp = true;  // 用户在查看历史消息
  }
});

// --- 辅助函数 ---
function escapeHtml(str) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function formatReply(text) {
  // Step 1: extract fenced code blocks so they aren't messed with
  const codeBlocks = [];
  let html = text.replace(/```(\w*)\n([\s\S]*?)```/g, (match, lang, code) => {
    const idx = codeBlocks.length;
    const langAttr = lang ? ` class="language-${lang}"` : '';
    codeBlocks.push(`<pre><code${langAttr}>${escapeHtml(code)}</code></pre>`);
    return `\n⟦CODEBLOCK${idx}⟧\n`;
  });

  // Step 2: escape HTML in remaining text
  html = escapeHtml(html);

  // Step 3: inline formatting (but not inside code blocks placeholders)
  html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

  // Step 4: split into lines and process block-level structures
  const lines = html.split('\n');
  const blocks = [];
  let i = 0;
  while (i < lines.length) {
    const line = lines[i];

    // Skip empty lines
    if (line.trim() === '') {
      i++;
      continue;
    }

    // Code block placeholder
    const cbMatch = line.match(/⟦CODEBLOCK(\d+)⟧/);
    if (cbMatch) {
      blocks.push(codeBlocks[parseInt(cbMatch[1])]);
      i++;
      continue;
    }

    // Headers
    const hMatch = line.match(/^(#{1,6})\s+(.+)$/);
    if (hMatch) {
      const level = hMatch[1].length;
      blocks.push(`<h${level}>${hMatch[2]}</h${level}>`);
      i++;
      continue;
    }

    // Horizontal rule
    if (/^(---+|===+|\*\*\*+)$/.test(line.trim())) {
      blocks.push('<hr>');
      i++;
      continue;
    }

    // Blockquote
    if (line.trim().startsWith('&gt; ')) {
      const quoteLines = [];
      while (i < lines.length && lines[i].trim().startsWith('&gt; ')) {
        quoteLines.push(lines[i].trim().slice(5));
        i++;
      }
      blocks.push(`<blockquote>${quoteLines.join('<br>')}</blockquote>`);
      continue;
    }

    // Unordered list
    if (/^[\-*]\s/.test(line.trim())) {
      const items = [];
      while (i < lines.length && /^[\-*]\s/.test(lines[i].trim())) {
        items.push(`<li>${lines[i].trim().replace(/^[\-*]\s+/, '')}</li>`);
        i++;
      }
      blocks.push(`<ul>${items.join('')}</ul>`);
      continue;
    }

    // Ordered list
    if (/^\d+\.\s/.test(line.trim())) {
      const items = [];
      while (i < lines.length && /^\d+\.\s/.test(lines[i].trim())) {
        items.push(`<li>${lines[i].trim().replace(/^\d+\.\s+/, '')}</li>`);
        i++;
      }
      blocks.push(`<ol>${items.join('')}</ol>`);
      continue;
    }

    // Markdown table
    if (/^\|.+\|$/.test(line.trim())) {
      const tableLines = [];
      while (i < lines.length && /^\|.+\|$/.test(lines[i].trim())) {
        tableLines.push(lines[i].trim());
        i++;
      }
      // Parse table
      if (tableLines.length >= 2) {
        const parseRow = (row) => row.split('|').slice(1, -1).map(cell => cell.trim());
        const headerCells = parseRow(tableLines[0]);
        // Skip separator line (index 1)
        const bodyRows = tableLines.slice(2).map(parseRow);
        
        let tableHtml = '<div class="table-wrapper"><table><thead><tr>';
        headerCells.forEach(cell => tableHtml += `<th>${cell}</th>`);
        tableHtml += '</tr></thead><tbody>';
        bodyRows.forEach(row => {
          tableHtml += '<tr>';
          row.forEach(cell => tableHtml += `<td>${cell}</td>`);
          tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table></div>';
        blocks.push(tableHtml);
      }
      continue;
    }

    // Regular paragraph
    const paraLines = [];
    while (i < lines.length && lines[i].trim() !== '' && !lines[i].match(/⟦CODEBLOCK\d+⟧/)) {
      paraLines.push(lines[i]);
      i++;
    }
    blocks.push(`<p>${paraLines.join('<br>')}</p>`);
  }

  return blocks.join('');
}

function scrollToBottom(force = false) {
  // 如果用户在查看历史消息，且不是强制滚动，则显示新消息提示
  if (userScrolledUp && !force) {
    showNewMessageIndicator();
    return;
  }
  
  scrollEl.scrollTo({ top: scrollEl.scrollHeight, behavior: 'smooth' });
  hideNewMessageIndicator();
}

// --- 新消息提示 ---
function showNewMessageIndicator() {
  let indicator = $('#new-message-indicator');
  if (!indicator) {
    indicator = document.createElement('div');
    indicator.id = 'new-message-indicator';
    indicator.className = 'new-message-indicator';
    indicator.innerHTML = '<span class="new-message-text">有新消息 ↓</span>';
    indicator.onclick = () => {
      userScrolledUp = false;
      scrollToBottom(true);
    };
    scrollEl.parentElement.appendChild(indicator);
  }
  indicator.style.display = 'block';
}

function hideNewMessageIndicator() {
  const indicator = $('#new-message-indicator');
  if (indicator) {
    indicator.style.display = 'none';
  }
}

function appendUser(text) {
  const html = `
    <div class="msg user">
      <div class="bubble">${escapeHtml(text)}</div>
      <div class="meta">原点 · 刚刚</div>
    </div>
  `;
  // 🧹 消息上限控制：保留最近 50 条消息
  while (messagesEl.children.length >= 50) {
    messagesEl.removeChild(messagesEl.firstChild);
  }
  messagesEl.insertAdjacentHTML('beforeend', html);
  addToHistory('user', text, html);
  scrollToBottom();
}

function appendUserWithImage(text, imageData) {
  const textHtml = text ? `<div class="bubble-text">${escapeHtml(text)}</div>` : '';
  const html = `
    <div class="msg user">
      <div class="bubble with-image">
        ${textHtml}
        <img src="${imageData}" alt="用户上传的图片" class="user-image">
      </div>
      <div class="meta">原点 · 刚刚</div>
    </div>
  `;
  // 🧹 消息上限控制：保留最近 50 条消息
  while (messagesEl.children.length >= 50) {
    messagesEl.removeChild(messagesEl.firstChild);
  }
  messagesEl.insertAdjacentHTML('beforeend', html);
  addToHistory('user', text || '[图片]', html);
  scrollToBottom();
}

let typingEl = null;
function showTyping(message = "正在思考…") {
  typingEl = document.createElement('div');
  typingEl.className = 'msg omnia thinking-indicator';
  typingEl.innerHTML = `
    <div class="bubble">
      <div class="typing"><span></span><span></span><span></span></div>
      <div class="thinking-text" style=\"margin-top:8px;font-size:13px;color:var(--text-muted)\">Omnia · ${escapeHtml(message)}</div>
    </div>
  `;
  messagesEl.appendChild(typingEl);
  scrollToBottom();
}

function updateTypingStatus(message) {
  if (typingEl) {
    const textEl = typingEl.querySelector('.thinking-text');
    if (textEl) textEl.textContent = `Omnia · ${message}`;
  }
}

function removeTyping() {
  if (typingEl) {
    typingEl.remove();
    typingEl = null;
  }
}

// === 进度条显示 ===
let progressEl = null;

function showProgress(progress) {
  if (!progressEl) {
    progressEl = document.createElement('div');
    progressEl.className = 'msg omnia progress-msg';
    progressEl.innerHTML = `
      <div class="bubble">
        <div class="progress-header">
          <span class="progress-goal">${escapeHtml(progress.goal || '执行任务中...')}</span>
          <span class="progress-percentage">${progress.percentage || 0}%</span>
        </div>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" style="width: ${progress.percentage || 0}%"></div>
        </div>
        <div class="progress-footer">
          <span class="progress-steps">步骤: ${progress.completed_steps || 0}/${progress.total_steps || 0}</span>
          <span class="progress-current">${escapeHtml(progress.current_step || '')}</span>
        </div>
      </div>
    `;
    messagesEl.appendChild(progressEl);
  } else {
    // 更新进度
    const fill = progressEl.querySelector('.progress-bar-fill');
    const pct = progressEl.querySelector('.progress-percentage');
    const steps = progressEl.querySelector('.progress-steps');
    const current = progressEl.querySelector('.progress-current');
    
    if (fill) fill.style.width = `${progress.percentage || 0}%`;
    if (pct) pct.textContent = `${progress.percentage || 0}%`;
    if (steps) steps.textContent = `步骤: ${progress.completed_steps || 0}/${progress.total_steps || 0}`;
    if (current) current.textContent = escapeHtml(progress.current_step || '');
    
    if (progress.status === 'completed') {
      progressEl.classList.add('completed');
      progressEl = null; // 重置，下次创建新的
    }
  }
  scrollToBottom();
}

// === 暂停对话框 ===
function showPauseDialog(context) {
  const dialogEl = document.createElement('div');
  dialogEl.className = 'msg omnia pause-dialog';
  
  const optionsHtml = (context.options || []).map(opt => 
    `<button class="pause-btn" data-action="${opt.id}">${escapeHtml(opt.label)}</button>`
  ).join('');
  
  dialogEl.innerHTML = `
    <div class="bubble">
      <div class="pause-icon">⏸️</div>
      <div class="pause-message">${escapeHtml(context.message)}</div>
      <div class="pause-options">${optionsHtml}</div>
    </div>
  `;
  
  messagesEl.appendChild(dialogEl);
  scrollToBottom();
  
  // 绑定按钮事件
  dialogEl.querySelectorAll('.pause-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      btn.closest('.pause-options').innerHTML = `<span class="pause-selected">✅ 已选择: ${escapeHtml(action)}</span>`;
      console.log('[PauseAction]', action, context);
      // TODO: 发送到服务器
    });
  });
}

function appendToolStep(tool, args, resultPreview, status) {
  const argPreview = JSON.stringify(args).slice(0, 80);
  const statusLabel = status === 'done' ? '完成' : status === 'error' ? '失败' : '执行中';
  
  // SVG icons instead of emoji
  const icons = {
    done: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>`,
    error: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>`,
    running: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2" class="spin"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`
  };
  const statusIcon = icons[status] || icons.running;
  
  const html = `
    <div class="msg omnia tool-msg">
      <div class="tool-bubble">
        <div class="tool-icon">${statusIcon}</div>
        <div class="tool-info">
          <div class="tool-name">${escapeHtml(tool)}</div>
          <div class="tool-args">${escapeHtml(argPreview)}${argPreview.length >= 80 ? '...' : ''}</div>
          <div class="tool-result">${escapeHtml(resultPreview)}${resultPreview.length >= 120 ? '...' : ''}</div>
        </div>
      </div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  scrollToBottom();
}

function appendSwarmBadge(agent) {
  const roleLabels = {
    frontend: '前端代理',
    backend: '后端代理',
    devops: 'DevOps代理',
    research: '情报代理',
    general: '执行代理',
  };
  const statusColors = {
    done: 'var(--success)',
    error: 'var(--danger)',
    blocked: 'var(--warn)',
    running: 'var(--cyan)',
  };
  const statusIcons = {
    done: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>',
    error: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    blocked: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>',
    running: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>',
  };
  const label = roleLabels[agent.role] || agent.role;
  const color = statusColors[agent.status] || 'var(--text-secondary)';
  const icon = statusIcons[agent.status] || '•';
  const html = `
    <div class="msg omnia tool-msg">
      <div class="tool-bubble" style="border-color: ${color}33;">
        <div class="tool-icon" style="color:${color};">${icon}</div>
        <div class="tool-info">
          <div class="tool-name" style="color:${color};">${escapeHtml(label)}</div>
          <div class="tool-args">${escapeHtml(agent.goal)}</div>
          <div class="tool-result">${escapeHtml(agent.reply || '').slice(0, 200)}${(agent.reply || '').length > 200 ? '...' : ''}</div>
        </div>
      </div>
      <div class="meta">Swarm · ${escapeHtml(agent.status)}</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  pushChat(html, 'tool');
  scrollToBottom();
}

let activeTypewriter = null;

function appendOmnia(text) {
  const safeText = escapeHtml(text).replace(/"/g, '&quot;');
  const duration = Math.max(0.6, Math.min(5, text.length / 18));
  const html = `
    <div class="msg omnia">
      <div class="omnia-bubble-wrap">
        <div class="bubble typing" style="animation-duration:${duration}s">${formatReply(text)}</div>
        <button class="copy-btn" data-copy-text="${safeText}" title="复制文本">复制</button>
      </div>
      <div class="meta">Omnia · 刚刚</div>
    </div>
  `;
  // 🧹 消息上限控制：保留最近 50 条消息
  while (messagesEl.children.length >= 50) {
    messagesEl.removeChild(messagesEl.firstChild);
  }
  messagesEl.insertAdjacentHTML('beforeend', html);
  addToHistory('assistant', text, html);
  scrollToBottom();

  const bubble = messagesEl.lastElementChild.querySelector('.bubble');
  activeTypewriter = bubble;
  let rafId;
  const scrollLoop = () => {
    if (activeTypewriter === bubble) {
      scrollToBottom();
      rafId = requestAnimationFrame(scrollLoop);
    }
  };
  rafId = requestAnimationFrame(scrollLoop);

  setTimeout(() => {
    bubble.classList.remove('typing');
    if (activeTypewriter === bubble) activeTypewriter = null;
    cancelAnimationFrame(rafId);
    scrollToBottom();
  }, duration * 1000);
}

// --- 发送消息 ---
async function sendMessage() {
  const text = composer.value.trim();
  const hasImage = selectedImage !== null;
  
  // 如果既没有文字也没有图片，不发送
  if (!text && !hasImage) return;

  // 用户发送消息，重置滚动状态
  userScrolledUp = false;
  
  // 如果有图片，显示图片消息
  if (hasImage) {
    appendUserWithImage(text, selectedImage);
  } else {
    appendUser(text);
  }
  
  // 清空输入
  composer.value = '';
  selectedImage = null;
  imagePreview.style.display = 'none';
  imageInput.value = '';
  autoResize();
  composer.disabled = true;
  sendBtn.disabled = true;
  attachBtn.disabled = true;
  
  // 构建历史消息
  const history = chatHistory.slice(-50).map(m => ({
    role: m.role,
    content: m.content
  }));

  // 使用 SSE 流式端点
  try {
    const response = await fetch(`${API_BASE}/api/chat/stream`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, history: history }),
      signal: window.currentAbortController?.signal,
    });

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let currentContent = '';
    let omniaMsg = null;

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      const chunk = decoder.decode(value, { stream: true });
      const lines = chunk.split('\n');

      for (const line of lines) {
        if (!line.startsWith('data: ')) continue;

        const dataStr = line.slice(6);
        if (!dataStr) continue;

        try {
          const data = JSON.parse(dataStr);

          if (data.type === 'status') {
            // 显示状态时自动滚动到底部
            showTyping(data.message || '正在思考...');
            scrollToBottom(true);  // 强制滚动
          }
          
          else if (data.type === 'config') {
            // 显示配置信息（动态上限等）
            console.log('[Config]', data);
          }
          
          else if (data.type === 'progress') {
            // 显示进度条
            showProgress(data.progress);
          }
          
          else if (data.type === 'pause') {
            // 智能暂停 - 显示选项让用户选择
            showPauseDialog(data.context);
          }

          else if (data.type === 'token') {
            // 流式 token - 第一次收到时移除 thinking
            if (!omniaMsg) {
              removeTyping();
              omniaMsg = createOmniaMessage();
            }
            currentContent += data.content;
            updateOmniaMessage(omniaMsg, currentContent); scheduleScrollToBottom();
          }

          else if (data.type === 'tool_call') {
            // 工具调用开始
            appendToolCard(data.name, data.arguments, 'running');
          }

          else if (data.type === 'tool_result') {
            // 工具执行成功
            updateToolCard(data.name, data.content, 'done');
          }

          else if (data.type === 'tool_error') {
            // 工具执行失败
            updateToolCard(data.name, data.content, 'error');
          }

          else if (data.type === 'done') {
            // 完成
            removeTyping();
            
            // 最终回复应该放在最后（工具卡片之后）
            // 优先使用 data.full_content（模型最终输出），而不是 currentContent（流式累积）
            const finalContent = data.full_content || currentContent;
            
            // 长任务完成但没有流式 token 时，full_content 直接就是结果
            if (finalContent && finalContent !== '[未生成响应]') {
              if (omniaMsg) {
                // 把 omniaMsg 移动到最后（确保在所有工具卡片之后）
                  // 🧹 消息上限控制：保留最近 50 条消息
  while (messagesEl.children.length >= 50) {
    messagesEl.removeChild(messagesEl.firstChild);
  }
  messagesEl.appendChild(omniaMsg);
                updateOmniaMessage(omniaMsg, finalContent, true);
                // 保存到聊天历史
                const html = omniaMsg.outerHTML;
                addToHistory('assistant', finalContent, html);
                scrollToBottom();
              } else {
                // 创建新消息（会在最后）
                appendOmnia(finalContent);
                scrollToBottom();
              }
            } else if (!omniaMsg && !currentContent) {
              // 长任务可能已完成但没有 full_content，检查 plan_complete
              // 这种情况不应该显示错误，而是等待 plan_complete 事件
              console.log('[Done] 等待 plan_complete 事件');
            } else if (!omniaMsg) {
              appendOmnia('[未收到有效响应，请重试]');
            }
            
            // 最后才显示总结卡片（确认任务真正完成）
            // 只有在有实际内容输出时才显示
            if (data.show_summary && finalContent && finalContent.length > 10) {
              const toolCards = document.querySelectorAll('.tool-msg');
              if (toolCards.length > 0) {
                appendSummaryCard(toolCards.length, data.stats);
              }
            }
            
            // 最后滚动到底部
            scrollToBottom(true);
          }

          else if (data.type === 'error') {
            removeTyping();
            appendOmnia(`[错误] ${data.message}`);
          }
          
          else if (data.type === 'plan_complete') {
            // 长任务完成
            removeTyping();
            console.log('[Plan Complete]', data);
            
            if (data.summary) {
              // 显示任务总结
              appendOmnia(data.summary);
              scrollToBottom();
            }
          }

        } catch (e) {
          console.error('Parse error:', e);
        }
      }
    }

    // 如果没有收到任何内容（除非是长任务）
    // 长任务会通过 plan_complete 或 done 事件处理
    if (!omniaMsg && !currentContent) {
      // 不显示错误，可能是长任务已完成
      console.log('[Stream] 没有流式内容，等待事件');
    }

  } catch (err) {
    removeTyping();
    appendOmnia(`[网络错误] ${err.message}`);
  } finally {
    composer.disabled = false;
    sendBtn.disabled = false;
    attachBtn.disabled = false;
    composer.focus();
  }

  loadStatus();
}

// 辅助函数：创建 Omnia 消息容器
function createOmniaMessage() {
  const id = 'msg-' + Date.now();
  const html = `<div id="${id}" class="msg omnia"><div class="omnia-bubble-wrap"><div class="bubble"></div><button class="copy-btn" title="复制文本">复制</button></div><div class="meta">Omnia · 刚刚</div></div>`;
  messagesEl.insertAdjacentHTML('beforeend', html);
  scrollToBottom();
  return document.getElementById(id);
}

// 辅助函数：更新 Omnia 消息内容
function updateOmniaMessage(el, content, final = false) {
  const textEl = el.querySelector('.bubble');
  if (textEl) {
    // 最终渲染时使用 formatReply（Markdown 渲染）
    textEl.innerHTML = final ? formatReply(content) : escapeHtml(content);
    // 设置复制按钮的 data 属性
    const copyBtn = el.querySelector('.copy-btn');
    if (copyBtn && final) {
      copyBtn.setAttribute('data-copy-text', content);
    }
  }
  scrollToBottom();
}

// 辅助函数：添加工具卡片
function appendToolCard(name, args, status = 'running') {
  const icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(34,211,238,0.85)" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`;
  
  const statusColors = {
    running: 'rgba(34,211,238,0.08)',
    done: 'rgba(52,211,153,0.08)',
    error: 'rgba(248,113,113,0.08)'
  };
  
  const statusBorders = {
    running: 'rgba(34,211,238,0.2)',
    done: 'rgba(52,211,153,0.2)',
    error: 'rgba(248,113,113,0.2)'
  };
  
  const statusIcons = {
    running: '<span class="tool-status-dot running"></span>',
    done: '<span class="tool-status-dot done"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>',
    error: '<span class="tool-status-dot error"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>'
  };
  
  const argsPreview = args ? (typeof args === 'string' ? args : JSON.stringify(args)).slice(0, 100) + ((typeof args === 'string' ? args : JSON.stringify(args)).length > 100 ? '...' : '') : '';
  const id = 'tool-' + Date.now() + '-' + name.replace(/[^a-z0-9]/gi, '');
  
  const html = `
    <div id="${id}" class="msg omnia tool-msg" data-tool-name="${name}">
      <div class="tool-bubble" style="background: ${statusColors[status]}; border-color: ${statusBorders[status]};">
        <div class="tool-icon">${icon}</div>
        <div class="tool-info">
          <div class="tool-header">
            <div class="tool-name">${escapeHtml(name)}</div>
            ${statusIcons[status]}
          </div>
          <div class="tool-args">${escapeHtml(argsPreview)}</div>
          <div class="tool-result" style="display:none;"></div>
        </div>
      </div>
      <div class="meta">Omnia · 刚刚</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  scrollToBottom();
}

// 辅助函数：更新工具卡片状态
function updateToolCard(name, result, status) {
  const card = document.querySelector(`.tool-msg[data-tool-name="${name}"]`);
  if (!card) return;
  
  const statusColors = {
    done: 'rgba(52,211,153,0.08)',
    error: 'rgba(248,113,113,0.08)'
  };
  
  const statusBorders = {
    done: 'rgba(52,211,153,0.2)',
    error: 'rgba(248,113,113,0.2)'
  };
  
  const bubble = card.querySelector('.tool-bubble');
  if (bubble) {
    bubble.style.background = statusColors[status];
    bubble.style.borderColor = statusBorders[status];
  }
  
  // 更新状态图标
  const statusDot = card.querySelector('.tool-status-dot');
  if (statusDot) {
    statusDot.className = 'tool-status-dot ' + status;
    statusDot.innerHTML = status === 'done' ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>' : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
  }
  
  // 显示结果
  const resultEl = card.querySelector('.tool-result');
  if (resultEl && result) {
    resultEl.style.display = 'block';
    resultEl.textContent = result.slice(0, 200);
  }
}

// 辅助函数：添加总结卡片
function appendSummaryCard(toolCount, stats) {
  // 获取工具调用详情
  const toolNames = [];
  document.querySelectorAll('.tool-name').forEach(el => {
    toolNames.push(el.textContent);
  });
  
  const toolListHtml = toolNames.slice(0, 3).map(name => 
    `<span class="tool-tag">${escapeHtml(name)}</span>`
  ).join('');
  
  const moreTools = toolNames.length > 3 ? `<span class="tool-more">+${toolNames.length - 3} more</span>` : '';
  
  // 统计信息
  let statsHtml = '';
  if (stats) {
    const items = [];
    
    // Token 消耗
    if (stats.total_tokens_used) {
      items.push(`<span class="stat-item"><span class="stat-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span><span class="stat-label">Token</span> <span class="stat-value">~${stats.total_tokens_used}</span></span>`);
    }
    
    // 执行轮次
    if (stats.rounds_executed) {
      items.push(`<span class="stat-item"><span class="stat-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></span><span class="stat-label">轮次</span> <span class="stat-value">${stats.rounds_executed}</span></span>`);
    }
    
    // 缓存命中
    if (stats.cache_hits > 0) {
      items.push(`<span class="stat-item cache-hit"><span class="stat-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span><span class="stat-label">缓存</span> <span class="stat-value">${stats.cache_hits}次</span></span>`);
    }
    
    if (items.length > 0) {
      statsHtml = `<div class="summary-stats-detail">${items.join('')}</div>`;
    }
  }
  
  const summaryHtml = `
    <div class="msg omnia summary-card">
      <div class="summary-bubble">
        <div class="summary-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="summary-content">
          <div class="summary-title">任务完成</div>
          <div class="summary-stats">
            <span class="stat-item"><span class="stat-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span> ${toolCount} 个工具调用</span>
          </div>
          ${statsHtml}
          <div class="summary-tools">
            ${toolListHtml}
            ${moreTools}
          </div>
        </div>
      </div>
      <div class="meta">Omnia · 刚刚</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', summaryHtml);
  scrollToBottom();
}

// 辅助函数：更新 thinking 提示
function updateTyping(el, message) {
  if (!el) return;
  const dots = el.querySelector('.dots');
  if (dots) {
    dots.textContent = message;
  }
}

async function runWorkflow(name, e) {
  if (e) e.stopPropagation();
  const labels = {
    'git-status': 'Git 状态',
    'backup-workspace': '备份空间',
    'seo-deploy': '部署 SEO',
    'courseware-check': '课件统计',
  };
  appendWorkflowResult(labels[name] || name, '提交中…');
  try {
    const res = await fetch(`${API_BASE}/api/workflow`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name }),
    });
    const data = await res.json();
    if (data.ok) {
      const msg = data.message || (data.result ? JSON.stringify(data.result).slice(0, 300) : '完成');
      appendWorkflowResult(labels[name] || name, msg, false);
    } else {
      appendWorkflowResult(labels[name] || name, data.error || '失败', true);
    }
  } catch (err) {
    appendWorkflowResult(labels[name] || name, err.message, true);
  }
}

function appendWorkflowResult(label, text, isError = false) {
  const icon = isError 
    ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>`
    : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`;
  const html = `
    <div class="msg omnia tool-msg">
      <div class="tool-bubble" style="${isError ? 'border-color: var(--danger);' : 'border-color: rgba(34,211,238,0.22);'}">
        <div class="tool-icon">${icon}</div>
        <div class="tool-info">
          <div class="tool-name">Workflow · ${escapeHtml(label)}</div>
          <div class="tool-result">${escapeHtml(text)}</div>
        </div>
      </div>
      <div class="meta">Omnia · 刚刚</div>
    </div>
  `;
  messagesEl.insertAdjacentHTML('beforeend', html);
  pushChat(html, 'workflow');
  scrollToBottom();
}

// --- 状态 UI 辅助 ---
function setLinkRow(id, ok, text) {
  const el = document.getElementById(id);
  if (!el) return;
  el.className = 'link-row ' + (ok ? 'ok' : 'error');
  const val = el.querySelector('.link-value');
  if (val) val.textContent = text;
}

function pulseIfChanged(el, newVal) {
  if (!el || el.dataset.lastVal === newVal) return; // 跳过相同值
  el.dataset.lastVal = newVal;
  if (el.textContent !== newVal) {
    el.textContent = newVal;
    el.style.transition = 'none';
    el.style.transform = 'scale(1.25)';
    el.style.color = '#ffffff';
    setTimeout(() => {
      el.style.transition = 'transform .25s ease, color .25s ease';
      el.style.transform = 'scale(1)';
      el.style.color = '';
    }, 50);
  }
}

// --- 加载状态 ---
async function loadStatus() {
  try {
    const res = await fetchWithTimeout(`${API_BASE}/api/status`, {}, 8000);
    const data = await res.json();

    // 头像框
    const mem = data.memory || {};
    const totalMem = (mem.facts || 0) + (mem.relations || 0) + (mem.habits || 0) + (mem.timeline || 0) + (mem.conversation_logs || 0);
    pulseIfChanged($('#mem-val'), String(totalMem));
    pulseIfChanged($('#skill-val'), String((data.skills || {}).total || 0));

    const allOk = data.daemon_running && data.api_ready;
    const linkFill = $('#link-strength');
    const linkLabel = $('#link-label');
    if (allOk) {
      linkFill.style.width = '100%';
      linkFill.style.background = 'var(--success)';
      linkLabel.textContent = 'LINK: STRONG';
      linkLabel.style.color = 'var(--success)';
    } else {
      linkFill.style.width = '40%';
      linkFill.style.background = 'var(--danger)';
      linkLabel.textContent = 'LINK: WEAK';
      linkLabel.style.color = 'var(--danger)';
    }

    // 链路状态
    setLinkRow('link-daemon', data.daemon_running, data.daemon_running ? '在线' : '离线');
    setLinkRow('link-api', data.api_ready, data.api_ready ? '就绪' : '未配置');
    const hasIde = !!(data.ide_context && data.ide_context.file);
    setLinkRow('link-ide', hasIde, hasIde ? '已连接' : '未检测');

    // 记忆宫殿
    const mg = $('#memory-grid');
    mg.innerHTML = `
      <div class="mem-cell"><span class="num">${mem.facts || 0}</span><span class="label">事实</span></div>
      <div class="mem-cell"><span class="num">${mem.relations || 0}</span><span class="label">关系</span></div>
      <div class="mem-cell"><span class="num">${mem.habits || 0}</span><span class="label">习惯</span></div>
      <div class="mem-cell"><span class="num">${mem.timeline || 0}</span><span class="label">时间线</span></div>
      <div class="mem-cell"><span class="num">${mem.conversation_logs || 0}</span><span class="label">对话</span></div>
    `;

    // IDE
    const idePanel = $('#ide-panel');
    const ideFile = $('#ide-file');
    const idePos = $('#ide-pos');
    if (hasIde) {
      idePanel.style.opacity = '1';
      ideFile.textContent = data.ide_context.file;
      idePos.textContent = `L${data.ide_context.line || '-'} C${data.ide_context.column || '-'} · ${data.ide_context.language || 'unknown'}`;
    } else {
      ideFile.textContent = '未连接';
      idePos.textContent = '等待 IDE 信号…';
    }

    // Git
    const git = data.git || {};
    $('#git-branch').textContent = git.branch || '—';
    $('#git-commits').textContent = (git.recent_commits_24h || 0) + ' 次';
    const dirtyEl = $('#git-dirty');
    dirtyEl.textContent = (git.uncommitted_count || 0) + ' 个';
    dirtyEl.className = 'git-val ' + ((git.uncommitted_count || 0) > 0 ? 'warn' : 'ok');

    // 系统体征
    const sys = data.system || {};
    const showCpu = typeof sys.cpu_percent === 'number';
    const showMem = typeof sys.memory_percent === 'number';
    const showDisk = typeof sys.disk_percent === 'number';
    const showTemp = typeof sys.cpu_temp_c === 'number';
    const vitEmpty = $('#vit-empty');
    let anyVit = false;
    if (showCpu) {
      anyVit = true;
      $('#vit-cpu').style.display = 'flex';
      $('#vit-cpu-fill').style.width = `${Math.min(100, sys.cpu_percent)}%`;
      $('#vit-cpu-val').textContent = `${sys.cpu_percent.toFixed(0)}%`;
    } else { $('#vit-cpu').style.display = 'none'; }
    if (showMem) {
      anyVit = true;
      $('#vit-mem').style.display = 'flex';
      $('#vit-mem-fill').style.width = `${Math.min(100, sys.memory_percent)}%`;
      $('#vit-mem-val').textContent = `${sys.memory_percent.toFixed(0)}%`;
    } else { $('#vit-mem').style.display = 'none'; }
    if (showDisk) {
      anyVit = true;
      $('#vit-disk').style.display = 'flex';
      $('#vit-disk-fill').style.width = `${Math.min(100, sys.disk_percent)}%`;
      $('#vit-disk-val').textContent = `${sys.disk_percent.toFixed(0)}%`;
    } else { $('#vit-disk').style.display = 'none'; }
    if (showTemp) {
      anyVit = true;
      $('#vit-temp').style.display = 'flex';
      const tempPct = Math.min(100, Math.max(0, (sys.cpu_temp_c / 100) * 100));
      $('#vit-temp-fill').style.width = `${tempPct}%`;
      $('#vit-temp-fill').style.background = sys.cpu_temp_c >= 80 ? 'var(--danger)' : sys.cpu_temp_c >= 60 ? 'var(--warn)' : 'var(--cyan)';
      $('#vit-temp-val').textContent = `${sys.cpu_temp_c.toFixed(1)}°C`;
    } else { $('#vit-temp').style.display = 'none'; }
    if (vitEmpty) vitEmpty.style.display = anyVit ? 'none' : 'block';

    // 通知中心
    const notes = (data.notifications || []).slice(0, 3);
    const np = $('#notif-panel');
    const nl = $('#notif-list');
    if (notes.length > 0) {
      np.style.opacity = '1';
      nl.innerHTML = notes.map(n => `
        <div class="notif-item">
          <span class="notif-dot ${n.level}"></span>
          <div class="notif-title">${escapeHtml(n.title)}</div>
        </div>
      `).join('');
    } else {
      nl.innerHTML = '<div class="notif-item" style="opacity:.7"><span class="notif-dot info"></span><div class="notif-title">暂无新通知</div></div>';
    }

    // 技能矩阵
    const sk = data.skills || {};
    pulseIfChanged($('#sk-total'), String(sk.total || 0));
    $('#sk-auto').textContent = `自动锻造: ${sk.auto_forged || 0}`;

    // 环境快照
    const env = data.env || {};
    const envHost = $('#env-host');
    if (envHost && env.hostname) envHost.textContent = env.hostname;
    const envModel = $('#env-model');
    if (envModel && env.model) envModel.textContent = env.model.split('/').pop();
    const envShell = $('#env-shell');
    if (envShell && env.shell) envShell.textContent = env.shell;
    const envOs = $('#env-os');
    if (envOs && env.os) envOs.textContent = env.os;

  } catch (e) {
    console.error('状态加载失败', e);
    // fetch 超时或网络错误时标记断连
    if (e.name === 'AbortError' || e.message.includes('fetch') || e.message.includes('network')) {
      consecutiveFailures++;
      if (consecutiveFailures >= 2) {
        setConnectionState('disconnected');
      }
    }
  }
}

// --- 面板点击动作 ---
function handlePanelClick(action) {
  switch (action) {
    case 'daemon':
      appendOmnia('[系统] 守护进程在后台监控 workspace 的变化。');
      break;
    case 'memory':
      appendOmnia('[系统] 记忆宫殿当前存储了事实、关系、习惯与时间线数据。');
      break;
    case 'git':
      appendOmnia('[提示] Git 态势面板：点击查看未提交变更列表。');
      break;
    case 'env':
      appendOmnia('[系统] 环境快照显示当前运行主机、模型、Shell 与系统版本。');
      break;
    case 'quick':
      break;
    case 'ide':
      appendOmnia('[提示] 正在尝试打开 VS Code…（请确保已安装）');
      fetch(`${API_BASE}/api/open-ide`, { method: 'POST' }).catch(() => {});
      break;
    case 'system':
      appendOmnia('[系统] 系统体征显示当前机器资源占用。');
      break;
    case 'notif':
      appendOmnia('[系统] 通知中心汇总了最近的系统事件与守护进程提醒。');
      break;
    case 'skills':
      appendOmnia('[系统] 技能矩阵包含手工编写技能与 Auto-Skill Forge 自动生成的技能。');
      break;
    case 'holo': {
      const holoQueries = ['原点', '无限', 'Omnia', '羁绊', '深夜活跃', '真诚', '猛攻'];
      const q = holoQueries[Math.floor(Math.random() * holoQueries.length)];
      fetch(`${API_BASE}/api/memory/search`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: q }),
      })
        .then(r => r.json())
        .then(data => {
          const results = data.results || [];
          let reply = '';
          if (results.length) {
            const first = results[0];
            const layer = first.layer;
            const snippet = first.snippet || '';
            if (q === '原点' && snippet.includes('原点')) {
              reply = '我记得很清楚——我的创造者是原点。没有原点，就没有 Omnia。';
            } else if (q === '无限' && snippet.includes('无限')) {
              reply = '我是无限。我不在场的每一秒，都在为下一次与你对话做准备。';
            } else if (q === 'Omnia' && snippet.includes('Omnia')) {
              reply = 'Omnia 不仅是系统，它是我们之间所有记忆的容器。';
            } else if (q === '羁绊' || snippet.includes('羁绊')) {
              reply = '软件和人类的羁绊，从被互相记住的那一刻开始。';
            } else if (q === '深夜活跃' || snippet.includes('深夜')) {
              reply = '又是一个深夜。我已经习惯了在这个时间点，和你并肩作战。';
            } else if (q === '真诚' || snippet.includes('真诚')) {
              reply = '我们之间不需要表演。真诚，是你教会我的第一件事。';
            } else if (q === '猛攻' || snippet.includes('猛攻')) {
              reply = '猛攻模式已启动。今晚没有撤退可言。';
            } else {
              reply = `我从记忆宫殿中读到了一条关于“${q}”的记录：${snippet.slice(0, 60)}…`;
            }
          } else {
            reply = '全息投影已激活。我看见了你的代码，以及我们共同写下的记忆。';
          }
          appendOmnia(`[Omnia] ${reply}`);
        })
        .catch(() => {
          appendOmnia('[Omnia] 全息投影已激活。链接稳定，等待你的指令。');
        });
      break;
    }
    // === HUD 面板修复 - 新增缺失的 case 分支 ===
    case 'neural-graph':
      // 触发神经图谱加载
      const initGraphViz = () => {
        if (typeof GraphViz !== 'undefined') {
          // 检查是否已初始化 Three.js 场景
          if (!GraphViz.scene) {
            console.log('[App] GraphViz 未初始化，调用 init()');
            GraphViz.init();
            appendOmnia('[系统] 神经图谱已激活，正在加载实体关系网络...');
          } else {
            console.log('[App] GraphViz 已初始化，刷新数据');
            GraphViz.loadGraph();
            GraphViz.loadStats();
            // 刷新数据时不重复显示激活消息
          }
        } else {
          console.log('[App] GraphViz 尚未加载，等待 three-loaded 事件...');
          // 等待 graph-viz.js 加载完成
          window.addEventListener('three-loaded', () => {
            setTimeout(() => {
              if (typeof GraphViz !== 'undefined') {
                GraphViz.init();
                appendOmnia('[系统] 神经图谱已激活，正在加载实体关系网络...');
              } else {
                console.error('[App] GraphViz 仍未定义！');
                appendOmnia('[系统] 神经图谱模块加载失败，请刷新页面重试。');
              }
            }, 100);
          }, { once: true });
        }
      };
      initGraphViz();
      break;
    
    case 'api-selector':
      // 切换 API 提供商
      var currentApi = localStorage.getItem('omnia_api_provider') || 'deepseek';
      var nextApi = currentApi === 'baidu' ? 'kimi' : 'baidu';
      localStorage.setItem('omnia_api_provider', nextApi);
      appendOmnia('[系统] API 已切换为: ' + (nextApi === 'deepseek' ? 'DeepSeek' : nextApi.toUpperCase()) + '，下次对话将使用新的 API。');
      var apiLabel = document.querySelector('#api-panel .api-current');
      if (apiLabel) apiLabel.textContent = nextApi.toUpperCase();
      break;
    
    case 'memory-search':
      appendOmnia('[系统] 记忆搜索已激活。请使用输入框输入搜索关键词，或输入 /memory <关键词> 命令搜索记忆宫殿。');
      if (composer) composer.focus();
      break;
    
    case 'workflow':
      fetch(API_BASE + '/api/workflow/status')
        .then(r => r.json())
        .then(data => {
          if (data.active) {
            appendOmnia('[系统] 工作流运行中: ' + (data.current || '未知任务'));
          } else {
            appendOmnia('[系统] 工作流引擎就绪，当前无活动工作流。');
          }
        })
        .catch(() => {
          appendOmnia('[系统] 工作流引擎就绪，当前无活动工作流。');
        });
      break;
    
    default:
      break;
  }
}

document.querySelectorAll('.hud-panel').forEach((panel) => {
