/**
 * 神经图谱可视化 - Force Graph 版本
 * 特性：流动粒子、节点自动散开、强交互性、科技感
 */

const GraphViz = {
  graph: null,
  graphData: { nodes: [], links: [] },
  particles: [],
  animationId: null,
  
  // 类型颜色映射
  typeColors: {
    'PERSON': '#22d3ee',    // 青色
    'PROJECT': '#a855f7',   // 紫色
    'FILE': '#10b981',      // 绿色
    'CONCEPT': '#f59e0b',   // 橙色
    'DATE': '#6366f1',      // 靛蓝
    'ENTITY': '#ec4899',    // 粉色
    'DEFAULT': '#64748b'    // 灰色
  },
  
  init() {
    console.log('[GraphViz] 初始化 Force Graph');
    this.loadStats();
    this.loadGraph();
  },
  
  getTypeColor(type) {
    return this.typeColors[type?.toUpperCase()] || this.typeColors['DEFAULT'];
  },
  
  async loadStats() {
    try {
      const res = await fetch('/api/graph/stats');
      const stats = await res.json();
      
      const nodesEl = document.getElementById('gs-nodes');
      const edgesEl = document.getElementById('gs-edges');
      
      if (nodesEl) nodesEl.textContent = stats.nodes || 0;
      if (edgesEl) edgesEl.textContent = stats.edges || 0;
      
      this.updateLegend(stats.nodes_by_type || {});
      
    } catch (err) {
      console.error('[GraphViz] 加载统计失败:', err);
    }
  },
  
  updateLegend(byType) {
    const types = ['PERSON', 'PROJECT', 'FILE', 'CONCEPT', 'DATE', 'ENTITY'];
    types.forEach(type => {
      const count = byType[type] || 0;
      const el = document.querySelector(`.legend-item .legend-dot.${type.toLowerCase()}`);
      if (el && count > 0) {
        const parent = el.closest('.legend-item');
        if (parent) {
          const textNodes = Array.from(parent.childNodes).filter(n => n.nodeType === 3);
          if (textNodes.length > 0) {
            textNodes[0].textContent = textNodes[0].textContent.trim() + ` (${count})`;
          }
        }
      }
    });
  },
  
  async loadGraph() {
    const container = document.getElementById('graph-canvas');
    if (!container) {
      console.error('[GraphViz] 找不到 graph-canvas');
      return;
    }
    
    container.innerHTML = '<div class="graph-loading"><div class="loading-spinner"></div>正在唤醒记忆...</div>';
    
    try {
      const res = await fetch('/api/graph?limit=200');
      const data = await res.json();
      
      console.log('[GraphViz] 节点:', data.nodes?.length, '边:', data.edges?.length);
      
      if (!data.nodes || data.nodes.length === 0) {
        container.innerHTML = '<div class="graph-placeholder">暂无图谱数据</div>';
        return;
      }
      
      // 创建 ID 映射
      const nameToId = {};
      data.nodes.forEach(n => {
        nameToId[n.name] = n.id;
        if (n.canonical_name) nameToId[n.canonical_name] = n.id;
      });
      
      // 准备 Force Graph 数据
      this.graphData = {
        nodes: data.nodes.map(n => ({
          id: n.id,
          name: n.name || n.label || n.id,
          type: n.type || 'DEFAULT',
          accessCount: n.access_count || 0,
          val: Math.max(3, Math.min(12, (n.access_count || 0) * 0.5 + 4)) // 节点大小
        })),
        links: data.edges
          .filter(e => nameToId[e.source] && nameToId[e.target])
          .slice(0, 300)
          .map((e, i) => ({
            source: nameToId[e.source],
            target: nameToId[e.target],
            relation: e.relation || 'related'
          }))
      };
      
      // 清空容器
      container.innerHTML = '';
      
      // 创建 Force Graph
      this.graph = ForceGraph()(container)
        .graphData(this.graphData)
        .width(container.clientWidth)
        .height(container.clientHeight)
        .backgroundColor('transparent')
        
        // 节点渲染
        .nodeCanvasObject((node, ctx, globalScale) => {
          const size = node.val * 2;
          const color = this.getTypeColor(node.type);
          
          // 外发光效果
          ctx.beginPath();
          ctx.arc(node.x, node.y, size + 4, 0, 2 * Math.PI);
          ctx.fillStyle = color + '20'; // 20% opacity glow
          ctx.fill();
          
          // 主节点
          ctx.beginPath();
          ctx.arc(node.x, node.y, size, 0, 2 * Math.PI);
          ctx.fillStyle = color;
          ctx.fill();
          
          // 内核高亮
          ctx.beginPath();
          ctx.arc(node.x, node.y, size * 0.4, 0, 2 * Math.PI);
          ctx.fillStyle = '#ffffff40';
          ctx.fill();
          
          // 标签（放大时显示）
          if (globalScale > 0.8) {
            ctx.font = `${Math.max(10, 12 / globalScale)}px Inter, sans-serif`;
            ctx.fillStyle = '#ffffff';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            ctx.fillText(node.name, node.x, node.y + size + 4);
          }
        })
        
        // 边渲染 - 流动粒子效果
        .linkCanvasObjectMode(() => 'after')
        .linkCanvasObject((link, ctx, globalScale) => {
          const start = link.source;
          const end = link.target;
          
          if (!start || !end || !Number.isFinite(start.x) || !Number.isFinite(end.y)) return;
          
          // 绘制连线
          ctx.beginPath();
          ctx.moveTo(start.x, start.y);
          ctx.lineTo(end.x, end.y);
          ctx.strokeStyle = 'rgba(100, 116, 139, 0.2)';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        })
        
        // 力导向参数
        .d3AlphaDecay(0.02)
        .d3VelocityDecay(0.3)
        .linkDistance(50)
        .linkStrength(0.1)
        .chargeStrength(-120)
        .collideRadius(8)
        
        // 交互
        .enableNodeDrag(true)
        .enableZoomInteraction(true)
        .enablePanInteraction(true)
        
        // 点击节点
        .onNodeClick(node => {
          if (node) {
            console.log('[GraphViz] 点击节点:', node.name, node.type);
            // 可以在这里添加详情面板
          }
        })
        
        // 悬停节点
        .onNodeHover(node => {
          container.style.cursor = node ? 'pointer' : 'default';
        });
      
      // 启动粒子动画
      this.startParticleAnimation();
      
      // 窗口大小调整
      window.addEventListener('resize', () => {
        if (this.graph) {
          this.graph.width(container.clientWidth).height(container.clientHeight);
        }
      });
      
      console.log('[GraphViz] Force Graph 渲染完成');
      
    } catch (err) {
      console.error('[GraphViz] 加载图谱失败:', err);
      container.innerHTML = '<div class="graph-error">加载失败</div>';
    }
  },
  
  /**
   * 流动粒子动画
   */
  startParticleAnimation() {
    if (this.animationId) {
      cancelAnimationFrame(this.animationId);
    }
    
    const container = document.getElementById('graph-canvas');
    if (!container || !this.graph) return;
    
    // 创建粒子
    this.particles = [];
    const particleCount = 50;
    
    for (let i = 0; i < particleCount; i++) {
      this.particles.push({
        linkIndex: Math.floor(Math.random() * this.graphData.links.length),
        progress: Math.random(),
        speed: 0.005 + Math.random() * 0.01,
        size: 1 + Math.random() * 2
      });
    }
    
    const animate = () => {
      if (!this.graph) return;
      
      const ctx = container.querySelector('canvas')?.getContext('2d');
      if (!ctx) {
        this.animationId = requestAnimationFrame(animate);
        return;
      }
      
      // 绘制粒子
      this.particles.forEach(particle => {
        const link = this.graphData.links[particle.linkIndex];
        if (!link || !link.source || !link.target) return;
        
        const start = link.source;
        const end = link.target;
        
        if (!Number.isFinite(start.x) || !Number.isFinite(end.x)) return;
        
        // 更新粒子位置
        particle.progress += particle.speed;
        if (particle.progress > 1) {
          particle.progress = 0;
          particle.linkIndex = Math.floor(Math.random() * this.graphData.links.length);
        }
        
        // 计算粒子坐标
        const x = start.x + (end.x - start.x) * particle.progress;
        const y = start.y + (end.y - start.y) * particle.progress;
        
        // 绘制粒子
        ctx.beginPath();
        ctx.arc(x, y, particle.size, 0, 2 * Math.PI);
        ctx.fillStyle = '#22d3ee80'; // 青色半透明
        ctx.fill();
        
        // 拖尾效果
        const tailLength = 10;
        const tailX = start.x + (end.x - start.x) * Math.max(0, particle.progress - 0.05);
        const tailY = start.y + (end.y - start.y) * Math.max(0, particle.progress - 0.05);
        
        ctx.beginPath();
        ctx.moveTo(tailX, tailY);
        ctx.lineTo(x, y);
        ctx.strokeStyle = '#22d3ee40';
        ctx.lineWidth = particle.size * 0.5;
        ctx.stroke();
      });
      
      this.animationId = requestAnimationFrame(animate);
    };
    
    animate();
  },
  
  /**
   * 停止动画
   */
  stopAnimation() {
    if (this.animationId) {
      cancelAnimationFrame(this.animationId);
      this.animationId = null;
    }
  },
  
  /**
   * 刷新图谱
   */
  refresh() {
    this.stopAnimation();
    this.loadGraph();
  }
};

// 导出到全局
window.GraphViz = GraphViz;
