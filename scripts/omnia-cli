#!/usr/bin/env python3
"""
Omnia CLI - 快速管理工具
用法: omnia <command> [options]
"""

import os
import sys
import json
import subprocess
import sqlite3
from pathlib import Path
from datetime import datetime
from typing import Optional, Dict, List

# 颜色定义
class Colors:
    RED = '\033[91m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'
    WHITE = '\033[97m'
    BOLD = '\033[1m'
    DIM = '\033[2m'
    RESET = '\033[0m'

# 配置路径
OMNIA_HOME = Path.home() / ".omnia"
PROJECT_ROOT = Path(__file__).parent.parent
PID_FILE = OMNIA_HOME / "daemon.pid"
LOG_FILE = OMNIA_HOME / "daemon.log"
MEMORY_DB = OMNIA_HOME / "memory_palace.db"
CONFIG_DIR = OMNIA_HOME / "config"


def print_header(title: str):
    """打印标题"""
    print(f"\n{Colors.BOLD}{Colors.CYAN}{'='*60}{Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.WHITE}  {title}{Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.CYAN}{'='*60}{Colors.RESET}\n")


def print_success(msg: str):
    print(f"{Colors.GREEN}✓ {msg}{Colors.RESET}")


def print_error(msg: str):
    print(f"{Colors.RED}✗ {msg}{Colors.RESET}")


def print_warning(msg: str):
    print(f"{Colors.YELLOW}⚠ {msg}{Colors.RESET}")


def print_info(msg: str):
    print(f"{Colors.BLUE}ℹ {msg}{Colors.RESET}")


def get_daemon_pid() -> Optional[int]:
    """获取守护进程 PID"""
    if not PID_FILE.exists():
        return None
    try:
        pid = int(PID_FILE.read_text().strip())
        # 检查进程是否存在
        os.kill(pid, 0)
        return pid
    except (ValueError, OSError):
        return None


def get_memory_stats() -> Dict:
    """获取记忆统计"""
    if not MEMORY_DB.exists():
        return {"error": "数据库不存在"}
    
    try:
        conn = sqlite3.connect(str(MEMORY_DB))
        cursor = conn.cursor()
        
        # 获取各层统计
        stats = {}
        layers = ['facts', 'relations', 'habits', 'timeline']
        
        for layer in layers:
            cursor.execute(f"SELECT COUNT(*) FROM {layer}")
            count = cursor.fetchone()[0]
            stats[layer] = count
        
        # 总计
        stats['total'] = sum(stats.values())
        
        # 数据库大小
        stats['db_size_mb'] = MEMORY_DB.stat().st_size / (1024 * 1024)
        
        conn.close()
        return stats
    except Exception as e:
        return {"error": str(e)}


def cmd_status():
    """显示系统状态"""
    print_header("Omnia 系统状态")
    
    # 守护进程状态
    pid = get_daemon_pid()
    if pid:
        print_success(f"守护进程运行中 (PID: {pid})")
    else:
        print_error("守护进程未运行")
    
    # API 状态
    try:
        import requests
        response = requests.get("http://localhost:8765/health", timeout=2)
        if response.status_code == 200:
            print_success("API 服务正常 (端口 8765)")
        else:
            print_warning(f"API 响应异常 (状态码: {response.status_code})")
    except:
        print_error("API 服务未响应")
    
    # 记忆统计
    print()
    stats = get_memory_stats()
    if "error" not in stats:
        print(f"{Colors.BOLD}记忆统计:{Colors.RESET}")
        print(f"  {Colors.BLUE}facts:{Colors.RESET}     {stats['facts']:>6} 条")
        print(f"  {Colors.MAGENTA}relations:{Colors.RESET} {stats['relations']:>6} 条")
        print(f"  {Colors.YELLOW}habits:{Colors.RESET}    {stats['habits']:>6} 条")
        print(f"  {Colors.CYAN}timeline:{Colors.RESET}  {stats['timeline']:>6} 条")
        print(f"  {Colors.BOLD}总计:{Colors.RESET}     {stats['total']:>6} 条")
        print(f"  {Colors.DIM}数据库大小: {stats['db_size_mb']:.2f} MB{Colors.RESET}")
    else:
        print_error(f"无法读取记忆: {stats['error']}")
    
    # 备份统计
    backup_dir = OMNIA_HOME / "backup"
    if backup_dir.exists():
        backups = list(backup_dir.glob("*.db*"))
        print(f"\n{Colors.BOLD}备份:{Colors.RESET} {len(backups)} 个文件")


def cmd_start():
    """启动守护进程"""
    pid = get_daemon_pid()
    if pid:
        print_warning(f"守护进程已在运行 (PID: {pid})")
        return
    
    print_info("启动守护进程...")
    daemon_script = PROJECT_ROOT / "scripts" / "start_daemon.py"
    
    try:
        subprocess.run([sys.executable, str(daemon_script)], check=True)
        print_success("守护进程已启动")
    except Exception as e:
        print_error(f"启动失败: {e}")


def cmd_stop():
    """停止守护进程"""
    pid = get_daemon_pid()
    if not pid:
        print_warning("守护进程未运行")
        return
    
    print_info(f"停止守护进程 (PID: {pid})...")
    try:
        os.kill(pid, 15)  # SIGTERM
        PID_FILE.unlink(missing_ok=True)
        print_success("守护进程已停止")
    except Exception as e:
        print_error(f"停止失败: {e}")


def cmd_restart():
    """重启守护进程"""
    cmd_stop()
    import time
    time.sleep(1)
    cmd_start()


def cmd_logs(lines: int = 50):
    """查看日志"""
    if not LOG_FILE.exists():
        print_warning("日志文件不存在")
        return
    
    print_header(f"最近 {lines} 行日志")
    
    try:
        result = subprocess.run(
            ["tail", "-n", str(lines), str(LOG_FILE)],
            capture_output=True,
            text=True
        )
        print(result.stdout)
    except Exception as e:
        print_error(f"读取日志失败: {e}")


def cmd_config():
    """编辑配置"""
    print_header("配置管理")
    
    config_files = list(CONFIG_DIR.glob("*.json")) if CONFIG_DIR.exists() else []
    
    if not config_files:
        print_warning("没有找到配置文件")
        return
    
    print("可用配置文件:")
    for i, f in enumerate(config_files, 1):
        print(f"  {i}. {f.name}")
    
    print()
    choice = input("选择要编辑的文件 (输入数字): ").strip()
    
    try:
        idx = int(choice) - 1
        if 0 <= idx < len(config_files):
            editor = os.environ.get('EDITOR', 'nano')
            subprocess.run([editor, str(config_files[idx])])
        else:
            print_error("无效选择")
    except:
        print_error("无效输入")


def cmd_backup():
    """备份记忆"""
    print_header("备份记忆")
    
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_file = OMNIA_HOME / "backup" / f"memory_palace_{timestamp}.db"
    backup_file.parent.mkdir(parents=True, exist_ok=True)
    
    if not MEMORY_DB.exists():
        print_error("记忆数据库不存在")
        return
    
    try:
        import shutil
        shutil.copy2(MEMORY_DB, backup_file)
        size_mb = backup_file.stat().st_size / (1024 * 1024)
        print_success(f"备份完成: {backup_file.name} ({size_mb:.2f} MB)")
    except Exception as e:
        print_error(f"备份失败: {e}")


def cmd_restore():
    """恢复备份"""
    print_header("恢复备份")
    
    backup_dir = OMNIA_HOME / "backup"
    if not backup_dir.exists():
        print_warning("没有找到备份目录")
        return
    
    backups = sorted(backup_dir.glob("memory_palace_*.db"), reverse=True)
    
    if not backups:
        print_warning("没有找到备份文件")
        return
    
    print("可用备份:")
    for i, f in enumerate(backups[:10], 1):  # 只显示最近10个
        mtime = datetime.fromtimestamp(f.stat().st_mtime)
        size_mb = f.stat().st_size / (1024 * 1024)
        print(f"  {i}. {f.name} ({size_mb:.2f} MB) - {mtime}")
    
    print()
    choice = input("选择要恢复的备份 (输入数字, 或 q 取消): ").strip()
    
    if choice.lower() == 'q':
        print_info("已取消")
        return
    
    try:
        idx = int(choice) - 1
        if 0 <= idx < len(backups[:10]):
            import shutil
            # 备份当前数据库
            if MEMORY_DB.exists():
                current_backup = MEMORY_DB.with_suffix(f".db.before_restore_{datetime.now().strftime('%Y%m%d_%H%M%S')}")
                shutil.copy2(MEMORY_DB, current_backup)
                print_info(f"当前数据库已备份到: {current_backup.name}")
            
            # 恢复
            shutil.copy2(backups[idx], MEMORY_DB)
            print_success(f"已恢复: {backups[idx].name}")
            print_warning("请重启守护进程以加载新数据")
        else:
            print_error("无效选择")
    except:
        print_error("无效输入")


def cmd_stats():
    """详细统计"""
    print_header("详细统计")
    
    stats = get_memory_stats()
    if "error" in stats:
        print_error(f"无法读取统计: {stats['error']}")
        return
    
    # 获取最近的记忆
    try:
        conn = sqlite3.connect(str(MEMORY_DB))
        cursor = conn.cursor()
        
        # 最近的事实
        cursor.execute("SELECT category, key, created_at FROM facts ORDER BY created_at DESC LIMIT 5")
        recent_facts = cursor.fetchall()
        
        print(f"{Colors.BOLD}最近添加的事实:{Colors.RESET}")
        for cat, key, created in recent_facts:
            print(f"  [{cat}] {key}")
        
        conn.close()
    except Exception as e:
        print_warning(f"无法读取详细数据: {e}")


def cmd_search(query: str):
    """搜索记忆"""
    if not query:
        print_error("请提供搜索关键词")
        return
    
    print_header(f"搜索: {query}")
    
    try:
        conn = sqlite3.connect(str(MEMORY_DB))
        cursor = conn.cursor()
        
        results = []
        
        # Facts
        cursor.execute("SELECT category, key, value FROM facts WHERE key LIKE ? OR value LIKE ?", 
                      (f"%{query}%", f"%{query}%"))
        for row in cursor.fetchall():
            results.append(("fact", row[0], row[1], row[2]))
        
        # Relations (使用 object 列)
        cursor.execute("SELECT subject, predicate, object FROM relations WHERE subject LIKE ? OR object LIKE ?",
                      (f"%{query}%", f"%{query}%"))
        for row in cursor.fetchall():
            results.append(("relation", row[0], row[1], row[2]))
        
        conn.close()
        
        if results:
            print(f"找到 {len(results)} 条结果:\n")
            for type_, *data in results[:20]:  # 只显示前20条
                if type_ == "fact":
                    print(f"  [{Colors.BLUE}{data[0]}{Colors.RESET}] {data[1]}: {data[2][:80]}")
                else:
                    print(f"  {data[0]} → {data[1]} → {data[2]}")
        else:
            print_warning("未找到匹配结果")
            
    except Exception as e:
        print_error(f"搜索失败: {e}")


def cmd_help():
    """显示帮助"""
    print_header("Omnia CLI 帮助")
    
    commands = [
        ("status", "显示系统状态"),
        ("start", "启动守护进程"),
        ("stop", "停止守护进程"),
        ("restart", "重启守护进程"),
        ("logs [N]", "查看最近 N 行日志 (默认 50)"),
        ("config", "编辑配置文件"),
        ("backup", "备份记忆数据库"),
        ("restore", "恢复备份"),
        ("stats", "显示详细统计"),
        ("search <query>", "搜索记忆"),
        ("help", "显示此帮助"),
    ]
    
    for cmd, desc in commands:
        print(f"  {Colors.GREEN}{cmd:<20}{Colors.RESET} {desc}")


def main():
    if len(sys.argv) < 2:
        cmd_status()
        return
    
    command = sys.argv[1].lower()
    args = sys.argv[2:]
    
    commands = {
        "status": cmd_status,
        "start": cmd_start,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "logs": lambda: cmd_logs(int(args[0]) if args else 50),
        "config": cmd_config,
        "backup": cmd_backup,
        "restore": cmd_restore,
        "stats": cmd_stats,
        "search": lambda: cmd_search(args[0] if args else ""),
        "help": cmd_help,
    }
    
    if command in commands:
        commands[command]()
    else:
        print_error(f"未知命令: {command}")
        print_info("运行 'omnia help' 查看可用命令")


if __name__ == "__main__":
    main()
